net.co.jp/company/philosophy/", "text": "企業理念", "alt_title": ""}, {"href": "https://infoxnet.co.jp/company/outline/", "text": "会社概要", "alt_title": ""}, {"href": "https://infoxnet.co.jp/company/csr/", "text": "CSR活動", "alt_title": ""}, {"href": "https://infoxnet.co.jp/product/", "text": "事業案内", "alt_title": ""}, {"href": "https://infoxnet.co.jp/product/", "text": "事業案内トップ", "alt_title": ""}, {"href": "https://infoxnet.co.jp/product/si/", "text": "SI事業", "alt_title": ""}, {"href": "https://infoxnet.co.jp/recruit/", "text": "採用情報", "alt_title": ""}, {"href": "https://infoxnet.co.jp/recruit/", "text": "採用情報トップ", "alt_title": ""}, {"href": "https://infoxnet.co.jp/recruit/newgraduate/", "text": "新卒募集要項", "alt_title": ""}, {"href": "https://infoxnet.co.jp/recruit/career/", "text": "キャリア募集要項", "alt_title": ""}, {"href": "https://infoxnet.co.jp/recruit/project/", "text": "プロジェクト事例紹介", "alt_title": ""}, {"href": "https://infoxnet.co.jp/recruit/interview/", "text": "社員インタビュー", "alt_title": ""}, {"href": "https://infoxnet.co.jp/recruit/company-introduction/", "text": "支店紹介", "alt_title": ""}, {"href": "https://infoxnet.co.jp/recruit/environment/", "text": "環境と制度", "alt_title": ""}, {"href": "https://infoxnet.co.jp/contact/", "text": "お問い合わせ", "alt_title": ""}, {"href": "#sm-overlay-search-box", "text": "search", "alt_title": ""}, {"href": "#sm-overlay-search-box", "text": "search", "alt_title": ""}, {"href": "/product/", "text": "活力ある社会をお客様と共に 富士インフォックス・ネットはネットワーク分野のパイオニアとしてソリューション事業を推進、設計・構築・運用に携わってまいりました。\nこの実績を礎にサステナブルな世界の創造と社会の課題解決に邁進いたします。", "alt_title": ""}, {"href": "/ai/", "text": "AIと共に進化する企業戦略 弊社はAIを活用し、業務効率化と提案力強化を推進しています。生成AIによる提案書作成や市場調査の迅速化に加え、情報提供用AIチャットボットも自社開発。さらに、AI関連の外部プロジェクト参画を計画し、新技術への挑戦と未来志向のソリューション創出を使命に、AIと共に進化し業界の常識を変える挑戦を続けます。", "alt_title": ""}, {"href": "/company", "text": "COMPANY INFORMATION \n会社情報 当社は創業以来、時代と世の中の変化へ対応した革新的なサービスを提供してまいりました。\nこれからは、築きあげたネットワークと技術力を活かし、地方創生や国際交流にフィールドを拡大していきます。", "alt_title": ""}, {"href": "/product", "text": "BUSINESS INFORMATION \n事業案内 当社はネットワーク分野の先駆者としてソリューション事業を推進し、情報インフラストラクチャーの設計・構築・運用に携わってまいりました。ネットワーク技術とITソリューションでビジネスをサポートいたします。", "alt_title": ""}, {"href": "/product/si/", "text": "さらに詳しく", "alt_title": ""}, {"href": "https://infoxnet.co.jp/news/%e6%8e%a1%e7%94%a8%e3%83%9a%e3%83%bc%e3%82%b8%e3%81%a7%e3%83%81%e3%83%a3%e3%83%83%e3%83%88%e3%83%9c%e3%83%83%e3%83%88%e3%81%8c%e3%81%94%e5%88%a9%e7%94%a8%e3%81%84%e3%81%9f%e3%81%a0%e3%81%91%e3%82%8b/", "text": "NEWS\t\n\n\n\n\n\t採用ページでチャットボットがご利用いただけるようになりました\n\n\n\t採用ページにチャットボットを設置し、より便利に情報をご確認いただけるようになりました。募集要項や応募方法、採用に関するよくあるご質問などを、チャット形式で手軽にご覧いただけます。 採用ページをご覧の際は、ぜひチャットボッ […]\n\n\n\nfurukawatts\t\t\t\n\n\t\t\t\t2026年04月09日\t\t\t\n\n\n\t\tNEWS", "alt_title": ""}, {"href": "https://infoxnet.co.jp/news/n-20251128/", "text": "NEWS\t\n\n\n\n\n\tフジキャリ事業撤退のお知らせ\n\n\n\t平素より格別のご高配を賜り、厚く御礼申し上げます。この度、弊社が提供してまいりました「Fuji Career（フジキャリ）」事業につきまして、事業の継続可能性を含めあらゆる観点から検討を行った結果、誠に遺憾ながら、同事業 […]\n\n\n\ninfox\t\t\t\n\n\t\t\t\t2025年11月28日\t\t\t\n\n\n\t\tNEWS", "alt_title": ""}, {"href": "https://infoxnet.co.jp/news/%e3%82%ad%e3%83%a3%e3%83%aa%e3%82%a2%e3%82%a2%e3%82%b7%e3%82%b9%e3%83%88%e6%98%b4%e3%81%ae%e3%83%9a%e3%83%bc%e3%82%b8%e3%82%92%e5%85%ac%e9%96%8b%e3%81%97%e3%81%be%e3%81%97%e3%81%9f/", "text": "NEWS\t\n\n\n\n\n\tキャリアアシスト昴のページを公開しました\n\n\n\n\ninfox\t\t\t\n\n\t\t\t\t2025年02月13日\t\t\t\n\n\n\t\tNEWS", "alt_title": ""}, {"href": "/news/", "text": "一覧を見る", "alt_title": ""}, {"href": "https://infoxnet.co.jp/recruit_lp/", "text": "RECRUIT\n採用情報", "alt_title": ""}, {"href": "/contact/", "text": "CONTACT\nお問い合わせ", "alt_title": ""}, {"href": "/company/", "text": "会社情報", "alt_title": ""}, {"href": "/company/message", "text": "トップメッセージ", "alt_title": ""}, {"href": "https://infoxnet.co.jp/company/philosophy/", "text": "企業理念", "alt_title": ""}, {"href": "/company/outline/", "text": "会社概要", "alt_title": ""}, {"href": "/company/csr/", "text": "CSR活動", "alt_title": ""}, {"href": "/product/", "text": "事業案内", "alt_title": ""}, {"href": "/product/si/", "text":