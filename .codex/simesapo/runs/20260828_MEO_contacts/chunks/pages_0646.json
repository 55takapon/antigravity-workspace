"alt_title": "icon"}, {"href": "../magazine/134", "text": "ACTIVITIES\nマーケティングWeek 春 2026 MaS【東京ビッグサイト】", "alt_title": "第1回 ブランド戦略・PR EXPO"}, {"href": "../magazine/119", "text": "STORIES\n防災教育 × 2Dメタバース 八千代エンジニヤリング株式会社 インタビュー", "alt_title": "“防災に関心がない層”に届ける、2Dバーチャルマップ開発"}, {"href": "../magazine/118", "text": "KNOWLEDGES\nリアルな撮影空間とCG背景、映像技術をリアルタイムで融合させるバーチャルプロダクション", "alt_title": "ARTORYの新規事業として始動したバーチャルプロダクション"}, {"href": "../topics/184", "text": "イベント\n第9回 EDIX大阪【グランキューブ大阪】教育総合展に出展のお知らせ", "alt_title": ""}, {"href": "../topics/183", "text": "イベント\nいよいよ今週末開催！第11回 関西教育ICT展【インテックス大阪】", "alt_title": ""}, {"href": "https://artory.co.jp/", "text": "", "alt_title": "株式会社アートリー"}, {"href": "../service/", "text": "サービス", "alt_title": ""}, {"href": "../casestudy/", "text": "事例紹介", "alt_title": ""}, {"href": "../works/", "text": "制作実績", "alt_title": ""}, {"href": "../studio/", "text": "スタジオ", "alt_title": ""}, {"href": "tel:0526846478", "text": "電話で質問（052-684-6478）", "alt_title": "icon"}, {"href": "../metaverse/office/", "text": "メタバースオフィスを訪問", "alt_title": "icon"}, {"href": "../", "text": "トップページ", "alt_title": ""}, {"href": "./../works/274", "text": "ブランディング縁日プロジェクト実行委員会\nイベントのリブランディングを支えるコンセプトアート。新たなビジョンを実現する指針となるキービジュアル制作", "alt_title": ""}, {"href": "./../works/369", "text": "プレスリリースVEDUTA\n“届けたい想い”を、世の中に届くニュースへ。社会的価値を引き出す、戦略的プレスリリース設計と発信支援", "alt_title": ""}, {"href": "./../works/239", "text": "ECサイト株式会社トップウェル\n色の組み合わせをCGで確認しながらオリジナルボックスを注文できるBtoB向けECサイト", "alt_title": ""}, {"href": "./../works/362", "text": "メタバース開発長崎県社会福祉協議会\nオンライン相談窓口をメタバースで実現。離島や県外からの応募者対応をスムーズに", "alt_title": ""}, {"href": "./../works/343", "text": "メタバース開発国立大学法人鳴門教育大学\nメタバースが創る、森の学び場。体験を通じて育まれる学びの好奇心が、次世代の教育の可能性を拓く", "alt_title": ""}, {"href": "./../works/271", "text": "予約システム株式会社エミュLab\n予約体験のパーソナライズで、サービスの価値提供を最大化する", "alt_title": ""}, {"href": "./../works/190", "text": "ランディングページ制作株式会社ECC\n地域の魅力と学びを結ぶ、ECC東海エリア向けランディングページ制作", "alt_title": ""}, {"href": "../works/?sort=new", "text": "新着順", "alt_title": "新着順"}, {"href": "../works/web/", "text": "Webサイト", "alt_title": "すべて"}, {"href": "../works/webservice/", "text": "Webサービス", "alt_title": "すべて"}, {"href": "../works/webapp/", "text": "Webアプリ・業務システム", "alt_title": "すべて"}, {"href": "../works/metaverse/", "text": "メタバース", "alt_title": "すべて"}, {"href": "../works/liveapp/", "text": "ライブ配信アプリ", "alt_title": "すべて"}, {"href": "../works/ecsite/", "text": "ECサイト", "alt_title": "すべて"}, {"href": "../works/ownedmedia/", "text": "オウンドメディア", "alt_title": "すべて"}, {"href": "../works/prmovie/", "text": "プロモーション動画", "alt_title": "すべて"}, {"href": "../works/movie/", "text": "番組・動画コンテンツ", "alt_title": "すべて"}, {"href": "../works/animationmovie/", "text": "アニメーション動画", "alt_title": "すべて"}, {"href": "../works/projectionmapping/", "text": "プロジェクションマッピング", "alt_title": "すべて"}, {"href": "../works/conceptart/", "text": "ブランディング", "alt_title": "すべて"}, {"href": "../works/adcreatives/", "text": "広告・プロモーション", "alt_title": "すべて"}, {"href": "../works/photo/", "text": "広告写真", "alt_title": "すべて"}, {"href": "../works/dtp/", "text": "パンフレット・印刷物", "alt_title": "すべて"}, {"href": "./../works/344", "text": "メタバース開発\n営業活動、マーケティングをまるごとバーチャルショールームで\n株式会社トヨタシステムズ｜トヨタシステムズ ASUNOVA Lab TS", "alt_title": "営業活動、マーケティングをまるごとバーチャルショールームで"}, {"href": "./../works/294", "text": "採用サイト\n創業から100年、新しい物語に挑戦する。“欲張り”な人材を求める採用サイトをリニューアル\nエスビー食品株式会社｜エスビー食品 採用サイト", "alt_title": "創業から100年、新しい物語に挑戦する。“欲張り”な人材を求める採用サイトをリニューアル"}, {"href": "./../works/373", "text": "ブランドクリエイティブ\nCO₂から描く循環の未来。世界初の資源化技術「メタコル」のブランドイメージをプロデュース\n住友電気工業株式会社｜metacol™ ブランドクリエイティブ制作", "alt_title": "CO₂から描く循環の未来。世界初の資源化技術「メタコル」のブランドイメージをプロデュース"}, {"href": "./../works/353", "text": "プロモーション動画\nペーパークラフトの街と水の躍動感が世界観を奏でる。香りと潤いの体験を表現した、シャンプーのブランディング動画\nMAISON COSME｜MAISON COSME LAUNCH COLLECTION", "alt_title": "ペーパークラフトの街と水の躍動感が世界観を奏でる。香りと潤いの体験を表現した、シャンプーのブランディング動画"}, {"href": "./../works/286", "text": "プロジェクションマッピング\n伝統とデジタルアートの融合。「大奥」シリーズの時代衣装がめくるめく移りゆく、絢爛たる着物プロジェクションマッピング\n縁日参りプロジェクト実行委員会｜豊川稲荷×着物詣（キモノモウデ）〜七燈伽藍〜", "alt_title": "伝統とデジタルアートの融合。「大奥」シリーズの時代衣装がめくるめく移りゆく、絢爛たる着物プロジェクションマッピング"}, {"href": "./../works/334", "text": "ルックブック撮影\n非公開の登録有形文化財建造物でルックブックを企画・撮影。文化・芸術を再解釈する和洋折衷のクリエーションを創出\nVEDUTA｜VEDUTA 2022 ルックブック撮影", "alt_title": "非公開の登録有形文化財建造物でルックブックを企画・撮影。文化・芸術を再解釈する和洋折衷のクリエーションを創出"}, {"href": "./../works/296", "text": "サービス紹介動画\nDX推進の課題をアニメーションで表現。企画から全工程をワンストップで制作\nNTTアドバンステクノロジ株式会社｜現場主導型RPAツール WinActor", "alt_title": "DX推進の課題をアニメーションで表現。企画から全工程をワンストップで制作"}, {"href": "./../works/6", "text": "Webサービス\n4,000ページを超える動的SEO対策と、掲載店舗のリアルタイム状況を検索できる大型ポータルサイト\n株式会社AOI｜相席ナビ ポータルサイト", "alt_title": "4,000ページを超える動的SEO対策と、掲載店舗のリアルタイム状況を検索できる大型ポータルサイト"}, {"href": "./../works/371", "text": "DTP制作\n複雑なDXソリューションを、誰にでも伝わるデザインに。RPAからAI異常検知まで、現場で機能する販促資料を制作\nNTTアドバンステクノロジ株式会社｜現場主導型RPAツール「WinActor」AI異常予兆検知ソリューション「@DeAnoS」DTP制作", "alt_title": "複雑なDXソリューションを、誰にでも伝わるデザインに。RPAからAI異常検知まで、現場で機能する販促資料を制作"}, {"href": "./../works/378", "text": "Webサービス\n整備・修理履歴から車両提案までを一元化。次の顧客接点へつなぐ自動車ディーラー向け顧客管理システム\n株式会社CAPTURE｜CAPTURE 顧客管理システム", "alt_title": "整備・修理履歴から車両提案までを一元化。次の顧客接点へつなぐ自動車ディーラー向け顧客管理システム"}, {"href": "./../works/377", "text": "Web制作・クリエイティブ制作\n「モヤモヤをワクワクに変える」自動車ディーラー向けサービスの世界観と提供価値を伝えるクリエイティブ制作\n株式会社CAPTURE｜CAPTURE ブランドロゴ・Webサイト制作", "alt_title": "「モヤモヤをワクワクに変える」自動車ディーラー向けサービスの世界観と提供価値を伝えるクリエイティブ制作"}, {"href": "./../works/376", "text": "メタバース開発\n卒園後の英語を途切れさせない、“放課後留学“メタバース学童プラットフォーム\nCOCOAS株式会社｜COCOAS KIDS Online After School", "alt_title": "卒園後の英語を途切れさせない、“放課後留学“メタバース学童プラットフォーム"}, {"href": "./../works/375", "text": "バーチャルマップ\n子供たちが楽しく学び、先生が成果を見える化する。バーチャルマップによる新しい学びのかたち\n八千代エンジニヤリング株式会社｜防災アニマル診断", "alt_title": "子供たちが楽しく学び、先生が成果を見える化する。バーチャルマップによる新しい学びのかたち"}, {"href": "./../works/374", "text": "メタバース開発\n学校へ行けなくても、学びは広がる。自分のペースで未来をひらくオンラインスクール\n株式会社RIDGE SPECIAL EDUCATION WORKS｜RIDGE ONLINE SCHOOL", "alt_title": "学校へ行けなくても、学びは広がる。自分のペースで未来をひらくオンラインスクール"}, {"href": "./../works/372", "text": "メタバース開発\n薬学生がつながる次世代の“メタバースキャンパス”。\n仲間と出会い、共に学ぶ、未来の学びを牽引するオンライン予備校\n学校法人医学アカデミー｜薬学ゼミナール メタバース予備校", "alt_title": "薬学生がつながる次世代の“メタバースキャンパス”。\n仲間と出会い、共に学ぶ、未来の学びを牽引するオンライン予備校"}, {"href": "./../works/370", "text": "ライブ配信・インターネット番組\n集結したライバーの同時配信をスタジオから届けるYouTubeライブ！「誰かの一日にHAPPYを届ける」番組イベントを生配信\n株式会社Activation｜誰かの一日に笑顔とHAPPYを☆ ライブ配信イベント", "alt_title": "集結したライバーの同時配信をスタジオから届けるYouTubeライブ！「誰かの一日にHAPPYを届ける」番組イベントを生配信"}, {"href": "./../works/369", "text": "プレスリリース\n“届けたい想い”を、世の中に届くニュースへ。社会的価値を引き出す、戦略的プレスリリース設計と発信支援\nVEDUTA｜VEDUTA プレスリリース", "alt_title": "“届けたい想い”を、世の中に届くニュースへ。社会的価値を引き出す、戦略的プレスリリース設計と発信支援"}, {"href": "./../works/368", "text": "メタバース開発\n事業紹介・採用ブランディング・現場理解がシームレスにつながる、次世代のメタバース空間 \n株式会社トヨタエンタプライズ｜トヨタエンタプライズ セキュリティソリューション本部メタバース", "alt_title": "事業紹介・採用ブランディング・現場理解がシームレスにつながる、次世代のメタバース空間 "}, {"href": "./../works/367", "text": "ホームページ・動画\n“学校の今”を、動きで伝える。パフォーマンス動画とともに生まれ変わったWebサイト\n株式会社国際教育センター｜名古屋スクールオブミュージック＆ダンス専門学校高等課程 Webサイト", "alt_title": "“学校の今”を、動きで伝える。パフォーマンス動画とともに生まれ変わったWebサイト"}, {"href": "./../works/363", "text": "Webサービス\nビジネスのやりたいことをシステム開発で実現。要件定義から戦略的に設計し、厳通なマッチングプラットフォームへ\n株式会社東京デザインアーツ｜Hello!コンシェル マッチングプラットフォーム", "alt_title": "ビジネスのやりたいことをシステム開発で実現。要件定義から戦略的に設計し、厳通なマッチングプラットフォームへ"}, {"href": "./pages/2", "text": "2", "alt_title": ""}, {"href": "./pages/3", "text": "3", "alt_title": ""}, {"href": "./pages/4", "text": "4", "alt_title": ""}, {"href": "./pages/5", "text": "5", "alt_title": ""}, {"href": "./pages/2", "text": "＞", "alt_title": ""}, {"href": "../service/", "text": "サービスを見る", "alt_title": ""}, {"href": "../casestudy/", "text": "事例を見る", "alt_title": ""}, {"href": "../company/", "text": "会社案内を見る", "alt_title": ""}, {"href": "../client-service/#sec3", "text": "資料ダウンロード\nARTORYの事例をまとめた資料をダウンロードいただけます。ぜひ検討用にご活用ください。", "alt_title": ""}, {"href": "../contact/", "text": "お問い合わせフォーム\n課題の整理段階からのご相談、お見積りのご依頼まで。専門スタッフが1〜2営業日以内にご返答します。", "alt_title": ""}, {"href": "tel:0526846478", "text": "TEL052-684-6478", "alt_title": ""}, {"href": "../client-service/", "text": "ご相談窓口", "alt_title": ""}, {"href": "../service/", "text": "サービス", "alt_title": ""}, {"href": "../w