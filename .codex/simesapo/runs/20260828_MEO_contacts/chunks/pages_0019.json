[{"idx": 148, "base_url": "https://nobono.jp/", "links": [{"href": "https://nobono.jp/", "text": "", "alt_title": "ノボノ株式会社"}, {"href": "https://nobono.jp/strength/", "text": "ノボノの強み", "alt_title": ""}, {"href": "https://nobono.jp/service/", "text": "サービス", "alt_title": ""}, {"href": "https://nobono.jp/cases/", "text": "支援事例", "alt_title": ""}, {"href": "https://nobono.jp/company/", "text": "会社紹介", "alt_title": ""}, {"href": "https://nobono.jp/recruit/", "text": "採用情報", "alt_title": ""}, {"href": "/", "text": "日本語", "alt_title": ""}, {"href": "/en/", "text": "English", "alt_title": ""}, {"href": "/zh/", "text": "中文简体", "alt_title": ""}, {"href": "https://nobono.jp/contact/", "text": "お問い合わせ", "alt_title": ""}, {"href": "/service/marketing/", "text": "マーケティング戦略立案・実行\n\nリサーチ起点で仮説を立て、価値検証で勝ち筋を見極めます。広告/SEOなどの集客、サイト/アプリのOwned改善（CRO・UX）、CRMまでを統合し、戦略〜実装〜改善を一気通貫で支援。顧客視点で成果を最大化します。\n\n\nVIEW MORE OUR SERVICE", "alt_title": ""}, {"href": "/service/ux/", "text": "顧客体験プランニング\n\n届けるべき相手は誰か、どんな期待や不安を抱え、どの瞬間に意思決定するのか。行動データと定性インサイトから顧客の体験を描き、価値が伝わる導線・情報設計・機能配置を設計します。設計は絵に終わらせず、Webサイト／アプリのUIへ落とし込み、コンテンツまで整備。テストを繰り返しながら、継続的にUI・UXを最適化します。\n\n\nVIEW MORE OUR SERVICE", "alt_title": ""}, {"href": "/service/promotion/", "text": "プロモーション・集客支援\n\nSEO対策からコンテンツ制作、広告運用、インフルエンサー施策、イベント集客まで。多様なチャネルを駆使し、ターゲットに響くプロモーションを設計・実行。効果測定と改善を繰り返し、持続的な集客とブランド成長を支援します。\n\n\nVIEW MORE OUR SERVICE", "alt_title": ""}, {"href": "/service/ec/", "text": "越境EC・インバウンド集客支援\n\n越境ECはリリースするだけでは伸びません。ノボノは、どの国で／誰に／何をどう売るかの戦略設計から、現地の運営体制づくり、広告・SNSを含むプロモーション、インフルエンサー活用までワンストップで伴走します。インバウンド施策やローカライズ、多言語対応も“実行できる形”に落とし込み、成果が出る導線まで整備。さらに、市場調査→テストマーケティングで勝ち筋を早期に見極め、海外展開を確度高く加速させます。\n\n\nVIEW MORE OUR SERVICE", "alt_title": ""}, {"href": "/service/research/", "text": "リサーチ・分析\n\n多角的な調査と高度な分析で、マーケティングの“なぜ”を解き明かす。定性・定量調査に加え、POS／購買データ、広告配信ログ、CRM・会員データ、Web/App行動データを統合し、施策と売上の関係を可視化します。MMM（マーケティング・ミックス・モデリング）でチャネル別の貢献度と予算最適化を行うなど、統計分析の専門性のあるスタッフも在籍しており、意思決定を速めるダッシュボード／分析環境まで整備し、再現性ある打ち手につなげます。\n\n\nVIEW MORE OUR SERVICE", "alt_title": ""}, {"href": "/service/web/", "text": "WEBサイト制作・運用\n\n顧客体験の設計から始め、迷わず見つかる・使いやすいWebサイトを構築します。誰が、どんな目的で訪れ、どの情報を探し、どこで意思決定するのか——その動線を描いたうえで、情報設計・導線設計・検索性（ファインダビリティ）・UIまで落とし込み、ブランド価値が自然に伝わる体験へ整えます。\n\n\nVIEW MORE OUR SERVICE", "alt_title": ""}, {"href": "/service/application/", "text": "アプリケーション開発\n\nスマホアプリからCMS、業務効率化を支える生成AIアプリまで、幅広いニーズに応える開発を実現。多彩なニーズに対応するシームレスな開発体制。最新技術を駆使し、ビジネスのデジタル革新を加速させます。\n\n\nVIEW MORE OUR SERVICE", "alt_title": ""}, {"href": "/cases/single/", "text": "公益社団法人 京都観世会\n京都観世会では初となる、デジタルマーケティングを中心に据えたプロモーション施策で各公演への集客効率の大幅アップを実現。\n狙ったターゲットへのアプローチをすることによる効率性の高い集客が可能に。\n\nプロモーション・集客支援\n\n\nVIEW MORE CASE STUDY", "alt_title": ""}, {"href": "/cases/single/", "text": "株式会社リンナイ\n撮影からクリエイティブを創造し、市場調査＆分析からサイトリニューアル\nすべてに意味のある根拠があるサイト設計で、売上増に貢献\n\nプロモーション・集客支援\n\n\nVIEW MORE CASE STUDY", "alt_title": ""}, {"href": "/cases/single/", "text": "株式会社 ZENB JAPAN\n香港でのECモール出店支援から、現地インスタグラマーを起用した認知施策をスピーディに実施\n迅速・的確なローカライズで、企業の海外進出のハードルを引き下げる\n\nプロモーション・集客支援\n\n\nVIEW MORE CASE STUDY", "alt_title": ""}, {"href": "https://nobono.jp/cases/", "text": "支援事例一覧へ", "alt_title": ""}, {"href": "/company/", "text": "COMPANY会社紹介 \n会社概要、代表、そして個性あふれるメンバーに迫る！\n\nVIEW MORE WHO WE ARE", "alt_title": ""}, {"href": "/strength/", "text": "STRENGTHノボノの強み \n成果を創出するNOBONOのマーケティング戦略を徹底解剖！\n\nVIEW MORE WHO WE ARE", "alt_title": ""}, {"href": "/recruit/", "text": "JOIN USマーケティングで社会を動かす、次世代の変革者を求む！\n\n\n採用情報へ", "alt_title": ""}, {"href": "https://nobono.jp/contact/", "text": "CONTACT USお問い合わせ\n\n依頼内容・ご予算が決まっていない場合も、お気軽にお問い合わせください。\n\nCONTACT US", "alt_title": ""}, {"href": "https://nobono.jp/download/", "text": "DOWNLOAD資料ダウンロード\n\nサービスについての詳しい資料をご用意しています。\n\nDOWNLOAD", "alt_title": ""}, {"href": "https://nobono.jp/strength/", "text": "ノボノの強み", "alt_title": ""}, {"href": "https://nobono.jp/service/", "text": "サービス", "alt_title": ""}, {"href": "https://nobono.jp/cases/", "text": "支援事例", "alt_title": ""}, {"href": "https://nobono.jp/company/", "text": "会社紹介", "alt_title": ""}, {"href": "htt