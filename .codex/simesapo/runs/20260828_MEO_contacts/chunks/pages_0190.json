[{"idx": 1581, "base_url": "https://bm-c.co.jp/", "links": [{"href": "https://bm-c.co.jp/", "text": "", "alt_title": "株式会社ブルーマークコンフィデンス"}, {"href": "/service/", "text": "事業紹介", "alt_title": ""}, {"href": "/company/", "text": "会社案内", "alt_title": ""}, {"href": "/recruit/", "text": "採用情報", "alt_title": ""}, {"href": "/news/", "text": "新着情報", "alt_title": ""}, {"href": "/contact/", "text": "お問い合わせ", "alt_title": ""}, {"href": "https://www.facebook.com/株式会社ブルーマークコンフィデンス-161454614718810/?modal=admin_todo_tour", "text": "", "alt_title": "フェイスブック"}, {"href": "https://www.instagram.com/official_bmc_/", "text": "", "alt_title": "インスタグラム"}, {"href": "/company/", "text": "READ MORE", "alt_title": ""}, {"href": "/service/#marketing", "text": "READ MORE", "alt_title": ""}, {"href": "/service/#solution", "text": "READ MORE", "alt_title": ""}, {"href": "/recruit/#career", "text": "キャリア採用", "alt_title": ""}, {"href": "/recruit/#education", "text": "教育制度", "alt_title": ""}, {"href": "/recruit/#benefit", "text": "福利厚生", "alt_title": ""}, {"href": "/recruit/#culture", "text": "社風", "alt_title": ""}, {"href": "https://www.instagram.com/p/DYgd63EhqTF/", "text": "", "alt_title": "先日、鑓田さんが作った豚骨ラーメンのスープをまたまたいただきました🍜\n美味しすぎて完まく………\n家でこのクオリティ作れるの凄すぎます\n\n▲になったチャーシューは、私が雑に作ったものです\nおせちに入ってるチャーシューの味がしました\n\n#自家製ラーメン\n#鑓田家\n#株式会社あまりにもウマすぎる\n#株式会社ブルーマークコンフィデンス"}, {"href": "https://www.instagram.com/p/DWP1nz0ARun/", "text": "おはようございます🌞\n今年度も、創", "alt_title": "おはようございます🌞\n今年度も、創業記念品を社員の皆さまへお送りしました！\nいつものカタログギフトに加え、今年度は10周年ということで\n記念品としてオリジナルボールペンを作りました🖊️\n\nBMCでは、販促品や記念品などにお使いいただけるノベルティ制作も受注しております✨\n\n#ノベルティグッズ #10周年"}, {"href": "https://www.instagram.com/p/DWDroehAVnm/", "text": "", "alt_title": "お野菜しおくり便、続々と社員宅へ届いております！\n\nこちらは市川さんからいただいた、ネギを使ったお料理の写真😋\n何か一言感想ください！と返信しましたら\n\"熱々の鶏肉とネギ炒め！\"\nとのことです🍄‍🟫\n\n忘れ去られた感想としめじはさておき、\nこんな一風変わった福利厚生も、BMCの良さの1つであります🌱\n\n#BMCファーム #福利厚生\n#季節の野菜"}, {"href": "https://www.instagram.com/p/DV72mStAdo-/", "text": "", "alt_title": "BMCファームで作っているお野菜を社員宅へお届け、その名も『お野菜しおくり便』が届きました✨\n\n今回はねぎ、生姜、にんじんのセットです！\n\nにんじんは、おつまみとして少し味しっかりめのキャロットラペに🥕\n調理する前に、まずはそのままスティックにしていただいたんですが\n甘くてびっくり！そのまま1本分食べてしまいました🥹\n\n生姜はまたまたジンジャーシロップにしました〜🫚\nねぎは焼いてマリネにしたり、カットして冷凍したり…\n少しだけ長野の実家へもお裾分けしました📦\n\n現在、ねぎは「わくわくひろば」ららぽーと湘南平塚店でも販売しているみたいなので\nお近くの方はぜひ、お試しください😊\n\n#BMCファーム #福利厚生\n#季節の野菜"}, {"href": "https://www.instagram.com/p/DTKWjUgAS7l/", "text": "", "alt_title": "遅くなりましたが、あけましておめでとうございます🎍\n年末に行った、忘年会と納会の様子を少しだけお届けします✨\n\nそして今日は、事務所メンバーで、宮益御嶽神社へ初詣に行ってきました！\n\n2026年も、駆け抜けます🔥\n\n#2026\n#初詣\n#忘年会\n#渋谷\n#宮益御嶽神社"}, {"href": "https://www.instagram.com/p/DQGxAObAXIc/", "text": "", "alt_title": "お久しぶりです。最近編み物を始めたBMCの吉田です🧶\n今週は一気に冷え込みましたね🍂\n\n昨日は恒例の社内飲み会が行われました🍻\n出向している社員や、現場への直行直帰が多い弊社にとって、\nこうした場は貴重な交流の時間です。\n\n初めて参加する社員もおり、\n社内の輪がさらに広がったのではないでしょうか🤝\n\nそして…\nおかげさまで、弊社は今期で10周年を迎えました🕊️\n\nこれまで支えてくださったクライアントの皆さま、\n一緒に歩んできた仲間たち、\nそして日頃よりご支援・ご愛顧を賜っているすべての方々へ、\n心より感謝申し上げます。\n\nこれからも、皆さまとのご縁を大切に、\n一歩ずつ成長を続けてまいります。\n\n引き続き、どうぞよろしくお願いいたします✨\n\n#10周年 #渋谷 #Anniversary \n#BlueMarkConfidence #株式会社ブルーマークコンフィデンス"}, {"href": "https://www.instagram.com/p/DH-y47OT0sU/", "text": "", "alt_title": "昨日は、渋谷のさくら坂近くにあるお店で春の懇親会をしました🍻🌸\n年度末から新年度にかけて、弊社にも新しい社員が加わり\nより一層邁進いたします✊\n\n実は今年の7月で10周年を迎えるBMC🕊️\n10周年企画も、何かできたらなぁと思っている今日この頃です…🏖️"}, {"href": "https://www.instagram.com/p/DEPyCoITKgB/", "text": "", "alt_title": "27日の最終営業日は納会をしました🍺\n1年の振り返りをしつつ、恒例のビンゴ大会で締めくくりました！\n\n今年も1年お疲れ様でした🙂‍↕️\nみなさま良いお年を！！\n#2024 #納会"}, {"href": "https://www.instagram.com/p/DDgv8u9zKXc/", "text": "昨日は忘年会でした🍻\nみなさま今年", "alt_title": "昨日は忘年会でした🍻\nみなさま今年もお疲れ様でした。\nあと数日残っていますが、年末まで頑張りましょう✊"}, {"href": "https://www.instagram.com/p/DB--SOOztgu/", "text": "", "alt_title": "新しい福利厚生として、BMCファームで作っているお野菜を社員宅へお届け、その名も『お野菜しおくり便』がはじまりました🧅✨\n\n今回はにんにく、新生姜、玉ねぎのセットです📦\n\n私は、いただいたお野菜を使って\n新生姜の甘酢漬けやキムチなどを作りました！\n小さい玉ねぎがとってもかわいい🫶🏻\n丸ごと使ってポトフを作ろうと思います🍴\n\n#BMCファーム #福利厚生\n#季節の野菜"}, {"href": "https://www.instagram.com/p/DYgd63EhqTF/", "text": "", "alt_title": "先日、鑓田さんが作った豚骨ラーメンのスープをまたまたいただきました🍜\n美味しすぎて完まく………\n家でこのクオリティ作れるの凄すぎます\n\n▲になったチャーシューは、私が雑に作ったものです\nおせちに入ってるチャーシューの味がしました\n\n#自家製ラーメン\n#鑓田家\n#株式会社あまりにもウマすぎる\n#株式会社ブルーマークコンフィデンス"}, {"href": "https://www.instagram.com/p/DWP1nz0ARun/", "text": "おはようございます🌞\n今年度も、創", "alt_title": "おはようございます🌞\n今年度も、創業記念品を社員の皆さまへお送りしました！\nいつものカタログギフトに加え、今年度は10周年ということで\n記念品としてオリジナルボールペンを作りました🖊️\n\nBMCでは、販促品や記念品などにお使いいただけるノベルティ制作も受注しております✨\n\n#ノベルティグッズ #10周年"}, {"href": "https://www.instagram.com/p/DWDroehAVnm/", "text": "", "alt_title": "お野菜しおくり便、続々と社員宅へ届いております！\n\nこちらは市川さんからいただいた、ネギを使ったお料理の写真😋\n何か一言感想ください！と返信しましたら\n\"熱々の鶏肉とネギ炒め！\"\nとのことです🍄‍🟫\n\n忘れ去られた感想としめじはさておき、\nこんな一風変わった福利厚生も、BMCの良さの1つであります🌱\n\n#BMCファーム #福利厚生\n#季節の野菜"}, {"href": "https://www.instagram.com/p/DV72mStAdo-/", "text": "", "alt_title": "BMCファームで作っているお野菜を社員宅へお届け、その名も『お野菜しおくり便』が届きました✨\n\n今回はねぎ、生姜、にんじんのセットです！\n\nにんじんは、おつまみとして少し味しっかりめのキャロットラペに🥕\n調理する前に、まずはそのままスティックにしていただいたんですが\n甘くてびっくり！そのまま1本分食べてしまいました🥹\n\n生姜はまたまたジンジャーシロップにしました〜🫚\nねぎは焼いてマリネにしたり、カットして冷凍したり…\n少しだけ長野の実家へもお裾分けしました📦\n\n現在、ねぎは「わくわくひろば」ららぽーと湘南平塚店でも販売しているみたいなので\nお近くの方はぜひ、お試しください😊\n\n#BMCファーム #福利厚生\n#季節の野菜"}, {"href": "https://www.instagram.com/p/DTKWjUgAS7l/", "text": "", "alt_title": "遅くなりましたが、あけましておめでとうございます🎍\n年末に行った、忘年会と納会の様子を少しだけお届けします✨\n\nそして今日は、事務所メンバーで、宮益御嶽神社へ初詣に行ってきました！\n\n2026年も、駆け抜けます🔥\n\n#2026\n#初詣\n#忘年会\n#渋谷\n#宮益御嶽神社"}, {"href": "https://www.instagram.com/p/DQGxAObAXIc/", "text": "", "alt_title": "お久しぶりです。最近編み物を始めたBMCの吉田です🧶\n今週は一気に冷え込みましたね🍂\n\n昨日は恒例の社内飲み会が行われました🍻\n出向している社員や、現場への直行直帰が多い弊社にとって、\nこうした場は貴重な交流の時間です。\n\n初めて参加する社員もおり、\n社内の輪がさらに広がったのではないでしょうか🤝\n\nそして…\nおかげさまで、弊社は今期で10周年を迎えました🕊️\n\nこれまで支えてくださったクライアントの皆さま、\n一緒に歩んできた仲間たち、\nそして日頃よりご支援・ご愛顧を賜っているすべての方々へ、\n心より感謝申し上げます。\n\nこれからも、皆さまとのご縁を大切に、\n一歩ずつ成長を続けてまいります。\n\n引き続き、どうぞよろしくお願いいたします✨\n\n#10周年 #渋谷 #Anniversary \n#BlueMarkConfidence #株式会社ブルーマークコンフィデンス"}, {"href": "https://www.instagram.com/p/DH-y47OT0sU/", "text": "", "alt_title": "昨日は、渋谷のさくら坂近くにあるお店で春の懇親会をしました🍻🌸\n年度末から新年度にかけて、弊社にも新しい社員が加わり\nより一層邁進いたします✊\n\n実は今年の7月で10周年を迎えるBMC🕊️\n10周年企画も、何かできたらなぁと思っている今日この頃です…🏖️"}, {"href": "https://www.inst