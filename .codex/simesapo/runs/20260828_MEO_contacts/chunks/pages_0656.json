f": "https://feel-design.jp/works_cate/facility/", "text": "店舗・施設", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/education/", "text": "教育関連", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/beauty-health/", "text": "美容・健康", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/hospital-medical/", "text": "医療・福祉関連", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/hobbies-learning/", "text": "趣味・習い事", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/children-parenting/", "text": "子育て関連", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/portfolio/", "text": "ポートフォリオサイト", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/practitioners/", "text": "士業ホームページ", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/sole-proprietor/", "text": "個人事業主", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/lp/", "text": "ランディングページ", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/movie/", "text": "動画撮影・編集", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/logo_design/", "text": "ロゴデザイン", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/card/", "text": "名刺・カード", "alt_title": ""}, {"href": "https://feel-design.jp/works_cate/pamphlet/", "text": "パンフレット・チラシ", "alt_title": ""}, {"href": "https://feel-design.jp/works/3235/", "text": "ASAHI JEWELRY\n\n女性向け店舗・施設 \nリニューアル後、商品についての具体的なお問い合わせや来店につながるケースが増加。商品カタログとして活用され、SNSから訪れる新しいお客様との接点づくりにも役立っています。", "alt_title": "ASAHI JEWELRY様"}, {"href": "https://feel-design.jp/works/3252/", "text": "神奈川エコハウス（nichi-nichi-ka）\n\nサービスサイト \n神奈川エコハウス株式会社様の、ガイドライン付き注文住宅nichi-nichi-ka（にちにちか）WEBサイト制作のご紹介です。", "alt_title": "神奈川エコハウス様"}, {"href": "https://feel-design.jp/works/3048/", "text": "株式会社太陽エージェンシー\n\nコーポレートサイト \n求人広告専門の広告代理店、株式会社太陽エージェンシー様からホームページ制作をご依頼いただきました。", "alt_title": "太陽エージェンシー様"}, {"href": "https://feel-design.jp/works/3273/", "text": "ホシミテ\n\nサービスサイト女性向け \nキャリアカウンセリングにホロスコープを取り入れ、カウンセラーと占星家が連携して相談を行う「ホシミテ」様のWEBサイト制作をご依頼いただきました。", "alt_title": "ホシミテ様のホームページ制作"}, {"href": "https://feel-design.jp/works/3567/", "text": "弦楽器工房フォレストバイオリン\n\nサービスサイト店舗・施設個人事業主 \n東京の弦楽器工房フォレストバイオリン様のWEBサイト制作実績です。ライティング、写真撮影も担当。WordPressによる更新しやすさに配慮したサイトを制作しました。", "alt_title": "弦楽器工房フォレストバイオリン"}, {"href": "https://feel-design.jp/works/3565/", "text": "MuralScape\n\nサービスサイトロゴデザイン \nMural Scape様のWEBサイト制作実績です。事業名・コンセプト設計、ライティング、ロゴデザインなど、新規ブランド立ち上げのサポートから担当いたしました。", "alt_title": "MuralScape様 ホームページ制作"}, {"href": "https://feel-design.jp/works/3563/", "text": "家庭教師のKeys\n\nサービスサイト教育関連 \n仙台市の家庭教師のKeys様のWEBサイト制作実績です。考え方・コース紹介を分かりやすく伝え、ブログなど、更新しやすいWordPressサイトとして制作しました。", "alt_title": "家庭教師のKeys様 ホームページ制作"}, {"href": "https://feel-design.jp/works/3561/", "text": "Million Kids\n\nサービスサイト店舗・施設ロゴデザイン \n多機能型児童発達支援事業所Million Kids様のWEBサイト制作実績です。安心感が伝わるデザイン、入園・採用への導線設計、WordPressによる更新しやすさに配慮して制作しました。", "alt_title": "多機能型児童発達支援事業所Million Kids様 ホームページ制作"}, {"href": "https://feel-design.jp/works/3559/", "text": "合同会社コアパス\n\nサービスサイト \n経営層向けコーチングを提供する合同会社コアパス様のWEBサイト制作実績です。コーチングメニューのわかりやすさ、問い合せ・申し込みへの導線設計に配慮したサイトを制作しました。", "alt_title": "合同会社コアパス様 ホームページ制作"}, {"href": "https://feel-design.jp/works/3556/", "text": "Mima bloom\n\nサービスサイト店舗・施設 \n東京・白金台のフラワーショップMima bloom様のWEBサイト制作実績です。花の写真が美しく映えるデザインと、Gallery・Newsを簡単に更新できるWordPressサイトを制作しました。", "alt_title": "Mima bloom様 ホームページ制作"}, {"href": "https://feel-design.jp/works/3553/", "text": "ギャラリーハットンガーデン\n\nサービスサイト趣味・習い事 \n東京のジュエリースクール「ギャラリーハットンガーデン」様のWEBサイト制作実績です。体験や説明会への導線設計、WordPressによる更新しやすさに配慮したサイトを制作しました。", "alt_title": "ギャラリーハットンガーデン様 ホームページ制作"}, {"href": "https://feel-design.jp/works/3551/", "text": "センシンメディカル株式会社\n\nコーポレートサイト \n医療機器・医療関連製品を取り扱うセンシンメディカル株式会社様のホームページリニューアル制作をしました。", "alt_title": "センシンメディカル株式会社様 ホームページ制作"}, {"href": "https://feel-design.jp/works/3549/", "text": "クレアスティレ合同会社\n\nコーポレートサイト \nイタリア人向け訪日旅行サービス手配を行う、クレアスティレ合同会社様のWEBサイト制作実績です。日本語・イタリア語・英語に対応した、信頼感のある多言語コーポレートサイトです。", "alt_title": "レアスティレ合同会社様 ホームページ制作"}, {"href": "https://feel-design.jp/works/3544/", "text": "ももたろうの投資道場\n\nサービスサイト \n投資情報を発信するブログサイト「ももたろうの投資道場」。記事を探しやすいカテゴリー設計にしつつ、WordPressカスタマイズにより、更新しやすいブログサイトを制作しました。", "alt_title": "ももたろうの投資道場 ホームページ制作"}, {"href": "https://feel-design.jp/works/3375/", "text": "株式会社リグノエッセンス\n\nコーポレートサイト \n震災で生まれた未利用の木材から紙の糸を生み出し、日本の伝統技術で布へと織り上げる、サステナブルファブリックブランド・株式会社リグノエッセンス様のホームページ制作のご紹介です。", "alt_title": "株式会社リグノエッセンス様のホームページ制作"}, {"href": "https://feel-design.jp/works/3373/", "text": "欅セラピールーム\n\nサービスサイト医療・福祉関連 \n欅セラピールーム様のホームページリニューアルを担当させていただきました。2017年に初回制作をご依頼いただき、今回はデザイン面のリニューアルとしてご相談をいただいています。", "alt_title": "欅セラピールーム様ホームページ制作"}, {"href": "https://feel-design.jp/works/3359/", "text": "ピアニスト 角谷千絢\n\n女性向け趣味・習い事ポートフォリオサイト \n宝塚市逆瀬川でピアノ教室を主宰し、演奏活動も行うピアニスト・角谷千絢様のホームページ制作をご依頼いただきました。", "alt_title": "ピアニスト角谷千絢様"}, {"href": "https://feel-design.jp/works/3357/", "text": "株式会社シーズン\n\nサービスサイト \n訪日外国人向けに、観光・送迎車両・通訳・ガイド・ホテル手配サービスを提供する株式会社シーズン様のホームページ制作をご依頼いただきました。", "alt_title": "株式会社シーズン"}, {"href": "https://feel-design.jp/works/3355/", "text": "シムピットストア\n\nサービスサイト店舗・施設 \n日本最大級のシミュレーター体験施設、シムピットストア様のホームページ制作を承りました。", "alt_title": "シムピットストア"}, {"href": "https://feel-design.jp/works/3350/", "text": "特定非営利活動法人手をつなご\n\nサービスサイト店舗・施設子育て関連 \n東京都練馬区で子育て支援に取り組む、特定非営利活動法人手をつなご様のホームページ制作をご担当させていただきました。", "alt_title": "特定非営利活動法人手をつなご様"}, {"href": "https://feel-design.jp/works/3352/", "text": "株式会社ボンマーク\n\nコーポレートサイト \n半導体パッケージ用メタルマスクの開発・製造・販売などを行う、株式会社ボンマーク様のホームページ制作をご依頼いただきました", "alt_title": "株式会社ボンマーク様"}, {"href": "https://feel-design.jp/works/3337/", "text": "株式会社CREER\n\nコーポレートサイトサービスサイト \nインフルエンサー事務所、株式会社CREER様のホームページを制作しました。", "alt_title": "株式会社CREER様のホームページ制作"}, {"href": "https://feel-design.jp/works/3335/", "text": "TBバーガー\n\n店舗・施設動画撮影・編集 \nグルメバーガー専門店TBバーガー様のホームページを制作しました。写真撮影に加え、動画撮影・編集もご依頼いただきました。", "alt_title": "TBバーガー様のホームページ制作"}, {"href": "https://feel-design.jp/works/3331/", "text": "nakasachi design studio.\n\nポートフォリオサイトロゴデザイン \nスタイリスト・衣装デザイナーの 中原幸子（nakasachi design studio.） 様の公式ホームページを制作しました。", "alt_title": "nakasachi design studio.様のホームページ制作"}, {"href": "https://feel-design.jp/works/3327/", "text": "みつばち大森山王教室\n\n店舗・施設教育関連 \n東京都大田区のみつばち大森山王教室様のホームページを制作しました。", "alt_title": "みつばち大森山王教室様 のホームページを制作"}, {"href": "https://feel-design.jp/works/3329/", "text": "株式会社バッテリー・コンサルティング\n\nコーポレートサイト \n採用支援、採用コンサルティングを行っている株式会社バッテリー・コンサルティング様のホームページを制作しました。", "alt_title": "株式会社バッテリー・コンサルティング様のホームページ制作"}, {"href": "https://feel-design.jp/works/3325/", "text": "bitBiome株式会社\n\nサービスサイト \n微生物のシングルセルゲノム解析技術を活用し、受託解析や共同研究開発を行うbitBiome株式会社 のサービスサイトを制作しました。", "alt_title": "bitBiome株式会社様のサービスサイト制作"}, {"href": "https://feel-design.jp/works/3309/", "text": "ひまわり小児歯科\n\n医療・福祉関連 \nひまわり小児歯科様のホームページリニューアルをご依頼いただきました。", "alt_title": "まわり小児歯科様のホームページリニューアル制作"}, {"href": "https://feel-design.jp/works/page/2/", "text": "2", "alt_title": ""}, {"href": "https://feel-design.jp/works/page/3/", "text": "3", "alt_title": ""}, {"href": "https://feel-design.jp/works/page/4/", "text": "4", "alt_title": ""}, {"href": "https://feel-design.jp/works/page/5/", "text": "5", "alt_title": ""}, {"href": "https://feel-design.jp/works/page/2/", "text": "›", "alt_title": ""}, {"href": "https://feel-design.jp/works/page/9/", "text": "»", "alt_title": ""}, {"href": "https://feel-design.jp/", "text": "HOME", "alt_title": ""}, {"href": "https://feel-design.jp/works/", "text": "実績紹介", "alt_title": ""}, {"href": "https://feel-design.jp/contact/", "text": "無料相談・お見積もり", "alt_title": ""}, {"href": "tel:0368685491", "text": "tel.03-6868-5491", "alt_title": ""}, {"href": "https://feel-design.jp/", "text": "ホーム", "alt_title": ""}, {"href": "https://feel-design.jp/news/", "text": "お知らせ", "alt_title": ""}, {"href": "https://feel-design.jp/voice/", "text": "お客様の声", "alt_title": ""}, {"href": "https://feel-design.jp/blog/", "text": "ブログ", "alt_title": ""}, {"href": "https://feel-design.jp/visitor/", "text": "初めての方へ", "alt_title": ""}, {"href": "https://feel-design.jp/visitor/", "text": "初めての方へTOP", "alt_title": ""}, {"href": "https://fee