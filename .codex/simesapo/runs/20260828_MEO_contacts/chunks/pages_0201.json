age-inc.net/", "links": [{"href": "./", "text": "", "alt_title": "Mediage"}, {"href": "./", "text": "HOME", "alt_title": ""}, {"href": "./service/", "text": "SERVICE", "alt_title": ""}, {"href": "./company.php", "text": "COMPANY", "alt_title": ""}, {"href": "./contact/", "text": "CONTACT", "alt_title": ""}, {"href": "./privacy.php", "text": "PRIVACY POLICY", "alt_title": ""}, {"href": "service/", "text": "Detail", "alt_title": ""}, {"href": "company.php", "text": "Detail", "alt_title": ""}, {"href": "tel:0649633462", "text": "06-4963-3462", "alt_title": ""}, {"href": "./contact/", "text": "Contact Form", "alt_title": ""}, {"href": "./", "text": "HOMEホーム", "alt_title": ""}, {"href": "./service/", "text": "SERVICE事業内容", "alt_title": ""}, {"href": "./company.php", "text": "COMPANY企業情報", "alt_title": ""}, {"href": "./contact/", "text": "CONTACTお問い合わせ", "alt_title": ""}, {"href": "./privacy.php", "text": "PRIVACY POLICY個人情報保護方針", "alt_title": ""}, {"href": "#", "text": "", "alt_title": ""}]}, {"idx": 1671, "base_url": "https://kumahisa.co.jp/index.html", "links": [{"href": "index.html", "text": "", "alt_title": "静岡のWeb制作会社、ホームページ制作からWebシステム制作"}, {"href": "about.html", "text": "会社概要", "alt_title": ""}, {"href": "service.html", "text": "サービス内容", "alt_title": ""}, {"href": "llckuma.html", "text": "LLC KUMAについて", "alt_title": ""}, {"href": "access.html", "text": "アクセス", "alt_title": ""}, {"href": "/inquiry/index.php", "text": "お問い合わせ", "alt_title": ""}, {"href": "javascript:void(0)", "text": "MENU", "alt_title": ""}, {"href": "https://cms.kumahisa.co.jp/", "text": "", "alt_title": "Web担当者様必見！！超速でWebサイト設置 / 超簡単、手間なしサイト運用"}, {"href": "https://gunshop.kumahisa.co.jp/", "text": "", "alt_title": "銃器・重要品の販売をはじめました。くまくまガンショップ"}, {"href": "service.html#service01", "text": "Website creation\n\r\n                    Webサイト制作\r\n                  \n\r\n                    ホームページ制作のお手伝いをします。もちろん、ただ単純に制作するだけではなく、その後、お客様自身がメンテできるようにCMSを導入します。", "alt_title": ""}, {"href": "service.html#service02", "text": "Web system development\n\r\n                    Webシステム開発\r\n                  \n\r\n                    QRコード決済システムや人工知能、Webシステムに関わることなら何でもやります。サーバーの構築、AWSやVMware等、仮想化の導入のお手伝いも得意です。", "alt_title": ""}, {"href": "service.html#service03", "text": "Website Management support\n\r\n                    Webサイト運営サポート\r\n                  \n\r\n                    運用のお手伝いを行っています。アクセス解析の結果や評価指標(KGI/KPI)をベースとしたご提案だけでなく、日常のメンテナンスのお手伝いまで行います。", "alt_title": ""}, {"href": "service.html#service04", "text": "Web Seminar\n\r\n                    Webセミナー\r\n                  \n\r\n                    Web運営・ディレクション、SEOを意識したWebサイトの運営ノウハウ、SNSを活用した商売繁盛支援など、幅広くわかりやすくお伝えします。", "alt_title": ""}, {"href": "service.html#service05", "text": "System development\n\r\n                    大規模システム\r\n                  \n\r\n                    開発に人数が必要な大規模システムの場合もお引き受けできます。弊社の得意分野である設計は国内で行い、開発は海外支社(ベトナム)にて行います。", "alt_title": ""}, {"href": "service.html#service06", "text": "Offshore\n\r\n                    オフショア開発\r\n                  \n\r\n                    エージェントを通さず、直接、海外の弊社子会社、開発会社と連携するので、開発の正確性や確実性は、他社のオフショア開発によりも自信があります。", "alt_title": ""}, {"href": "https://gunshop.kumahisa.co.jp/", "text": "猟銃、及び、狩猟用品の販売をはじめました。", "alt_title": ""}, {"href": "https://cms.kumahisa.co.jp/", "text": "超簡単にWebサイトが作れるすげーソリューション。KUMAKUMA CMS", "alt_title": ""}, {"href": "llckuma.html", "text": "LLC KUMAがダナンの中心部へ引っ越しました。", "alt_title": ""}, {"href": "javascript:void(0);", "text": "Webサイトをリニューアルしました。", "alt_title": ""}, {"href": "https://www.facebook.com/kumahisa.system", "text": "株式会社くまひさ", "alt_title": ""}, {"href": "about.html", "text": "くまひさ会社情報", "alt_title": ""}, {"href": "access.html", "text": "アクセス", "alt_title": ""}, {"href": "llckuma.html", "text": "LLCKUMAについて", "alt_title": ""}, {"href": "privacy.html", "text": "個人情報保護方針", "alt_title": ""}, {"href": "privacy.html#toriatukai", "text": "個人情報の取扱について", "alt_title": ""}, {"href": "security.html", "text": "情報セキュリティ方針", "alt_title": ""}, {