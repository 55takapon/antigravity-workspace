[{"idx": 3035, "base_url": "https://www.sib.tv/", "links": [{"href": "/", "text": "トップtop", "alt_title": ""}, {"href": "https://www.sib.tv/service/", "text": "サービスservice", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/", "text": "実績showcase", "alt_title": ""}, {"href": "https://www.sib.tv/company/", "text": "会社案内company", "alt_title": ""}, {"href": "https://www.sib.tv/news/", "text": "ニュースnews", "alt_title": ""}, {"href": "https://www.sib.tv/recruit/", "text": "リクルートrecruit", "alt_title": ""}, {"href": "https://www.sib.tv/contact/", "text": "お問い合わせcontact", "alt_title": ""}, {"href": "#kv-scroll", "text": "SCROLL", "alt_title": ""}, {"href": "https://www.sib.tv/service/business/", "text": "広告事業\n\n街頭ビジョン運営\n渋谷横丁サイネージ運営\nSHIBUYA WALL JACK\nイベント制作\nスペースメディア\nその他運用媒体\nデジタルサイネージ構築サポート", "alt_title": ""}, {"href": "https://www.sib.tv/service/livehall/", "text": "音楽事業\n\nライブホール運営\n音楽イベント制作", "alt_title": ""}, {"href": "https://www.sib.tv/service/k-arena", "text": "Kアリーナ横浜周辺事業\n\n飲食運営\n売店・ショップ運営\nメディア運営", "alt_title": ""}, {"href": "https://www.sib.tv/service/other/", "text": "その他事業\n\nワンちゃんとご家族の会員制複合施設\n映像制作\nグラフィックデザイン制作\nWEB制作\nフォトサービス事業\n次世代のストリートカルチャーを発信\n渋谷大型ビジョン 30秒ニュース番組", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/10059/", "text": "more\n\n\nSHIBUYA NODOJIMAN\n\n開催時期\n\n                                                    【予選会】\r\n                                                     2025年10月24日(金)　笹塚ボウル\r\n                                                     2025年11月6日(木)　タワーレコード渋谷店 CUTUP STUDIO\r\n                                                     2025年11月17日(月)　リフレッシュ氷川\r\n                                                     2025年11月29日(土)　地域交流センター新橋\r\n                                                     2025年12月7日(日)　YCC 代々木八幡コミュニティセンター\r\n                                                     　\r\n                                                     【本選】\r\n                                                     2026年2月7日(土)　渋谷区文化総合センター大和田 さくらホール                                             \n\n\n                      「SHIBUYA NODOJIMAN」は、渋谷区在住・在勤・在学の人を対象に、世代も国籍も関係なく、誰もが主役になれる参加型カラオケイベントで2025年度に初開催されました。\r\n事務局業務以外に、5会場でおよそ100組が参加する予選会の制作・当日の運営等を行ないました。\r\n\r\n予選を勝ち抜いた30組が、渋谷の大舞台「文化総合センター大和田　さくらホール」でその歌声を披露しました。……", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/9783/", "text": "more\n\n\nSTRIDER CUP 2025 かぜのステージ／うみのステージ\n\n開催時期\n\n                                                    2025年5月25日、26日(かぜのステージ)／2025年11月23日(うみのステージ)                                             \n\n\n                      2025年はSTRIDER CUPが日本でスタートしてから15周年という記念イヤーでした。\r\n5月の関西会場を初めて神戸ハーバーランドメリケンパークで開催し、11月の関東会場は5回目の幕張メッセでの開催となりました。\r\n両会場ともに、ストライダーがなくても楽しめるコンテンツを目的に来場され、盛り上がりました。", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/9779/", "text": "more\n\n\n第48回渋谷区くみんの広場 ふるさと渋谷フェスティバル2025\n\n開催時期\n\n                                                    2025年11月2日(土)、3日(日)                                             \n\n\n                      毎年11月の第1土曜・日曜に代々木公園で開催される、渋谷区民の出会い・ふれあい・交流の場として、地域連帯の輪を広げる渋谷区最大規模のお祭りです。\r\n区民の方に渋谷区の理解を深めていただく「知ろうよ！渋谷区ゾーン」制作管理業務やスポーツ団体のコンテンツ運営などを行いました。", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/9774/", "text": "more\n\n\nSHIBUYA MIYASHITA PARK BON DANCE 2025\n\n開催時期\n\n                                                    2025年9月27日(土)、28日(日)                                             \n\n\n                      「渋谷のカルチャーと日本の伝統的な祭りの融合を目的とし、ダンス、ミュージック、ファッションを自由で、かしこまらず、誰でも楽しめる」がコンセプトのBON DANCE。\r\n2日間に渡って宮下公園芝生広場で実施し、多くの来場者が渋谷の秋の夜長を満喫しました。", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/9766/", "text": "more\n\n\n第28回 渋谷・鹿児島おはら祭（本祭り 踊りパレード）\n\n開催時期\n\n                                                    2025年5月18日（日）                                             \n\n\n                      毎年5月中旬の日曜日に道玄坂～文化村通りの交通規制を行い、 2,000人以上の踊り手が練り歩くイベントです。\r\n渋谷・鹿児島ゆかりの「おはら節｣､｢渋谷音頭｣､｢ハンヤ節｣､｢渋谷発！ ハンヤ節」で渋谷のメインストリートが“かごしま”に染まりました。", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/8699/", "text": "more\n\n\nDIG SHIBUYA 2025\n\n開催時期\n\n                                                    2025年2月8日～11日                                             \n\n\n                      「渋谷まるごと、ART×TECKの実験中」をテーマに、公園通りを中心とした公共空間を使い、アートとテクノジーを体験できるイベントとして開催されました。\r\n公園通りでは大型のアートインスタレーションの展示、街頭ビジョンを活用した屋外型エキシビション、有識者のカンファレンス、公募団体による展示など\r\n来街者が気軽にアートや最新テクノロジーに触れる機会をテーマに様々なプログラムを実施しました。……", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/9713/", "text": "more\n\n\nSTRIDER CUP 2024 たいようのステージ／うみのステージ\n\n開催時期\n\n                                                    2024年5月25日、26日(たいようのステージ)／11月17日(うみのステージ)                                             \n\n\n                      元祖世界最年少のレースイベント、ストライダーカップ。2010年に日本で開催されて以来、世界中で開催されているストライダーの公式レースです。 レース以外のコンテンツやプログラムを充実させ、多くのファミリーにストライダーの世界観を体験いただき、STRIDER CUP過去最高の動員を記録しました。", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/9712/", "text": "more\n\n\n第47回渋谷区くみんの広場 ふるさと渋谷フェスティバル2024\n\n開催時期\n\n                                                    2024年11月2日、3日                                             \n\n\n                      「わが街と誇れる渋谷」の形成を目指す区民の集いとして昭和53年に第1回をスタートし、今回で47回目を迎えた渋谷区最大規模のお祭りです。\r\n今年はハワイ州ホノルル市、ペルーのミラフローレス区との姉妹都市協定を結んだことで2都市のPRブースが展開されました。", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/7988/", "text": "more\n\n\nSHIBUYA MIYASHITA PARK BON DANCE 2024\n\n開催時期\n\n                                                    2024年9月21日、9月22日                                             \n\n\n                      渋谷にカルチャーと日本の伝統的な祭りの融合による人々の交流を目的とし、「ミュージック+ファッション+ダンス+アート」を発信するイベントを2日間に渡って実施しました。\r\n盆踊りやDJによるダンスミュージックの他、渋谷のナイトベニューを中心としたドリンク&フード、アパレルショップによる縁日スタイルのマーケット、ご当地のよりすぐりのクラフトドリンクなど個性あふれる出店で夏の終わりのひとときを盛り上げまし……", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/7844/", "text": "more\n\n\nWAN楽市2024\n\n開催時期\n\n                                                    2024年10月5日（土）                                                     10月6日（日）                                             \n\n\n                      当社が運営する犬と人のための大型複合施設『WANCOTT(ワンコット)』が毎年開催している施設最大のイベントです。\r\n今年は『大収穫祭～WANCOTTでつくる新たな絆～』をテーマに、コロナ禍を乗り越えコミュニケーションの大切さが見直された今、以前とはどこか違った新しいWANCOTTを感じていただきたいという思いを込め、人×人、人×犬、犬×犬のコミュニケーションを重視したイベントを実施しました。\r\n……", "alt_title": ""}, {"href": "https://www.sib.tv/showcase/", "text": "もっと実績をみる", "alt_title": ""}, {"href": "https://www.sib.tv/news/10449/", "text": "イベント制作 2026.08.26\nSHIBUYA MIYASHITA PARK BON DANCE 2026 が開催されます！", "alt_title": ""}, {"href": "https://www.sib.tv/news/10444/", "text": "音楽イベント制作 2026.07.22\n「MURO FESTIVAL 2026」開催間近となりました！", "alt_title": ""}, {"href": "https://www.sib.tv/news/10438/", "text": "ライブホール運営 2026.06.29\n【MURO FESTIVAL 2026】を開催いたします！", "alt_title": ""}, {"href": "https://www.sib.tv/news/10416/", "text": "ライブホール運営 2026.06.02\n「YATSUI　FESTIVAL！2026」開催間近となりました！", "alt_title": ""}, {"href": "https://www.sib.tv/news/10408/", "text": "街頭ビジョン 2026.05.19\n渋谷西口スカイビジョン　新設のお知らせ", "alt_title": ""}, {"href": "https://www.sib.tv/news/10210/", "text": "2026.03.23\n当社所属アーティスト「小野正利」の公式サイトをリニューアルしました！", "alt_title": ""}, {"href": "https://www.sib.tv/news/", "text": "ニュース一覧", "alt_title": ""}, {"href": "#pagetop", "text": "", "alt_title": ""}, {"href": "https://www.sib.tv/service/business/", "text": "広告事業", "alt_title": ""}, {"href": "https://nspace.sib.tv/", "text": "n_space", "alt_title": ""}, {"href": "https://www.sib.tv/service/livehall/", "text": "音楽事業", "alt_title": ""}, {"href": "http://shibuya-o.com/", "text": "Shibuya O-Group", "alt_title": ""}, {"href": "https://azumaya.jp/", "text": "東間屋", "alt_title": ""}, {"href": "https://www.onomasatoshi.com/", "text": "MASATOSHI ONO", "alt_title": ""}, {"href": "http://believemusicstore.com/", "text": "BELIEVE MUSIC store", "alt_title": ""}, {"href": "http://sound-s.jp/", "text": "ボーカルスクール Bese~美声~", "alt_title": ""}, {"href": "https://www.sib.tv/service/k-arena", "text": "Kアリーナ横浜周辺事業", "alt_title": ""}, {"href": "https://k-arena.com/", "text": "Kアリーナ横浜", "alt_title": ""}, {"href":