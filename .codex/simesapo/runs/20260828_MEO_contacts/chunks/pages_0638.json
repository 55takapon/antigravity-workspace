[{"idx": 5363, "base_url": "https://asahilinks.com/case/", "links": [{"href": "https://wprescue.jp/", "text": "WordPressレスキュー\n\nWordPress改善・保守の専門会社", "alt_title": ""}, {"href": "https://wprescue.jp/", "text": "TOP", "alt_title": ""}, {"href": "https://wprescue.jp/service/", "text": "サービス", "alt_title": ""}, {"href": "https://wprescue.jp/service/diagnosis/", "text": "診断項目", "alt_title": ""}, {"href": "https://wprescue.jp/price/", "text": "料金", "alt_title": ""}, {"href": "https://wprescue.jp/case/", "text": "事例", "alt_title": ""}, {"href": "https://wprescue.jp/blog/", "text": "お役立ち情報", "alt_title": ""}, {"href": "https://web.runland.co.jp/", "text": "運営会社", "alt_title": ""}, {"href": "https://wprescue.jp/contact/", "text": "無料相談する", "alt_title": ""}, {"href": "https://wprescue.jp/", "text": "ホーム", "alt_title": ""}, {"href": "https://wprescue.jp/case/case-manufacturing-30/", "text": "作業日数\n約4日\n\n古いWordPress（4系）を最新6系へ安全にアップデート\n\n課題WordPress 4系のまま放置され脆弱性リスクが高い 解決段階アップデートで6系へ安全に移行し安定化 \n\n88,000円（税込）\n中規模実装プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/case-law-office-8/", "text": "作業日数\n約5日\n\nPHP7.4→8.2 バージョンアップ対応（非対応プラグイン改修）\n\n課題PHP7.4のサポート終了で一部プラグインが警告を出す 解決非対応プラグインを改修しPHP8.2で正常動作を確保 \n\n98,000円（税込）\n中規模実装プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/case-consulting-15/", "text": "作業日数\n約6日\n\n長期放置サイトの本体・テーマ・プラグインを総点検し一括最新化\n\n課題数年放置で本体・テーマ・プラグインが大量に古い 解決依存関係を整理し安全な順序で一括最新化 \n\n128,000円（税込）\n中規模実装プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e5%bb%ba%e8%a8%ad%e6%a5%ad%e3%80%91wordpress%e6%9b%b4%e6%96%b0%e5%be%8c%e3%81%ae%e3%82%b9%e3%83%9e%e3%83%9b%e8%a1%a8%e7%a4%ba%e5%b4%a9%e3%82%8c%e3%82%922%e6%97%a5%e3%81%a7%e5%be%a9%e6%97%a7/", "text": "作業日数\n約3日\n\nWordPress更新後の表示崩れを復旧し、子テーマ化で再発防止\n\n課題更新後にレイアウトが崩れ元に戻せない 解決崩れを復旧し子テーマ化で再発を防止 \n\n68,000円（税込）\n小規模実装プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e4%b8%8d%e5%8b%95%e7%94%a3%e6%a5%ad%e3%80%91%e9%87%8d%e3%81%8f%e3%81%aa%e3%81%a3%e3%81%9f%e7%89%a9%e4%bb%b6%e6%8e%b2%e8%bc%89%e3%82%b5%e3%82%a4%e3%83%88%e3%81%ae%e8%a1%a8%e7%a4%ba%e9%80%9f/", "text": "作業日数\n約2日\n\nメジャーアップデート前の検証環境テスト代行\n\n課題大型更新をいきなり本番で行うのが不安 解決検証環境で事前テストし影響範囲を確認 \n\n55,000円（税込）\n小規模実装プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e5%a3%ab%e6%a5%ad%ef%bc%88%e7%a8%8e%e7%90%86%e5%a3%ab%e6%b3%95%e4%ba%ba%ef%bc%89%e3%80%91%e6%9c%aa%e5%af%be%e5%bf%9c%e3%81%a0%e3%81%a3%e3%81%9fseo%e5%86%85%e9%83%a8%e8%a8%ad%e5%ae%9a/", "text": "WordPress本体・プラグインの月次更新代行（継続保守）\n\n課題本体・プラグインの更新まで手が回らない 解決月次でバックアップ後に安全な更新を代行 \n\n22,000円／月（税込）\n継続保守（月額） \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e5%bb%ba%e8%a8%ad%e6%a5%ad%e3%80%91%e6%8e%a1%e7%94%a8%e3%82%b5%e3%82%a4%e3%83%88%e3%81%ae%e3%83%95%e3%82%a9%e3%83%bc%e3%83%a0%e3%83%a1%e3%83%bc%e3%83%ab%e6%9c%aa%e9%81%94%e3%82%92%e8%a7%a3/", "text": "作業日数\n約3日\n\nお問い合わせフォームに自動返信・条件分岐を追加\n\n課題問い合わせ後の自動返信がなく取りこぼしが不安 解決自動返信と条件分岐で受付対応を効率化 \n\n78,000円（税込）\n小規模実装プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e5%88%b6%e4%bd%9c%e4%bc%9a%e7%a4%be%e3%80%91wordpress%e5%b0%82%e9%96%80%e3%83%91%e3%83%bc%e3%83%88%e3%83%8a%e3%83%bc%e3%81%a8%e3%81%97%e3%81%a6%e7%b6%99%e7%b6%9a%e6%94%af%e6%8f%b4%e3%81%ab/", "text": "作業日数\n約6日\n\n予約受付フォーム機能の追加\n\n課題電話中心の予約受付で対応の負担が大きい 解決Web予約フォームを追加し受付を24時間化 \n\n118,000円（税込）\n中規模実装プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e4%b8%8d%e5%8b%95%e7%94%a3%e6%a5%ad%e3%80%91lp%ef%bc%8b%e3%82%b3%e3%83%bc%e3%83%9d%e3%83%ac%e3%83%bc%e3%83%88%e3%82%b5%e3%82%a4%e3%83%88%e3%81%ae%e5%95%8f%e3%81%84%e5%90%88%e3%82%8f%e3%81%9b/", "text": "作業日数\n約10日\n\nカスタム投稿タイプ＋絞り込み検索の実装\n\n課題情報が増え目的の項目を探しにくい 解決カスタム投稿と絞り込み検索で回遊性を向上 \n\n198,000円（税込）\n大規模実装プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e5%bb%ba%e8%a8%ad%e6%a5%ad%e3%80%91%e8%84%86%e5%bc%b1%e6%80%a7%e8%ad%a6%e5%91%8a%e3%82%92%e4%b8%80%e6%8e%83%e3%81%97%e3%82%bb%e3%82%ad%e3%83%a5%e3%83%aa%e3%83%86%e3%82%a3%e9%81%8b%e7%94%a8/", "text": "作業日数\n約12日\n\n会員限定ページ（会員制）機能の追加\n\n課題限定情報を特定ユーザーだけに見せたい 解決会員登録と権限で限定ページを保護 \n\n238,000円（税込）\n大規模実装プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e5%8c%bb%e7%99%82%e3%80%91%e9%80%a3%e7%b5%a1%e3%81%8c%e5%8f%96%e3%82%8c%e3%81%aa%e3%81%84%e5%88%b6%e4%bd%9c%e4%bc%9a%e7%a4%be%e3%81%8b%e3%82%89wordpress%e4%bf%9d%e5%ae%88%e3%82%92%e5%bc%95/", "text": "作業日数\n約3週間\n\n外部API連携（在庫・予約データ同期）の開発\n\n課題在庫や予約データを手作業で二重管理している 解決外部APIと連携しデータを自動同期 \n\n380,000円（税込）\nカスタム開発プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e5%a3%ab%e6%a5%ad%e3%80%91%e3%82%aa%e3%82%a6%e3%83%b3%e3%83%89%e3%83%a1%e3%83%87%e3%82%a3%e3%82%a2%e3%81%ae%e6%a4%9c%e7%b4%a2%e6%b5%81%e5%85%a5%e3%82%92seo%e8%a8%ba%e6%96%ad%e3%83%bb/", "text": "作業日数\n約3週間\n\n業務専用の独自プラグイン開発\n\n課題既存プラグインでは業務要件を満たせない 解決要件に合わせた独自プラグインを開発 \n\n320,000円（税込）\nカスタム開発プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e5%88%b6%e4%bd%9c%e4%bc%9a%e7%a4%be%e3%80%91wordpress%e7%8b%ac%e8%87%aa%e9%96%8b%e7%99%ba%ef%bc%88%e3%82%ab%e3%82%b9%e3%82%bf%e3%83%a0%e6%8a%95%e7%a8%bf%e3%83%bb%e4%bc%9a%e5%93%a1%e5%88%b6/", "text": "作業日数\n約12日\n\n多言語対応（英語・中国語）の実装\n\n課題日本語のみで海外からの閲覧に対応できない 解決英語・中国語ページを追加し多言語対応 \n\n218,000円（税込）\n大規模実装プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e5%bb%ba%e8%a8%ad%e6%a5%ad%e3%80%91%e3%82%b5%e3%82%a4%e3%83%88%e6%94%b9%e3%81%96%e3%82%93%e8%a2%ab%e5%ae%b3%e3%81%8b%e3%82%89%e3%81%ae%e5%be%a9%e6%97%a7%e3%81%a8google%e8%ad%a6%e5%91%8a/", "text": "作業日数\n約4週間\n\nコーポレートサイトの新規制作（WordPress）\n\n課題サイトが古く会社の印象を伝えきれない 解決WordPressで運用しやすい新サイトを制作 \n\n480,000円（税込）\n制作プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/%e3%80%90%e4%b8%8d%e5%8b%95%e7%94%a3%e6%a5%ad%e3%80%91wordpress%e3%82%a2%e3%83%83%e3%83%97%e3%83%87%e3%83%bc%e3%83%88%e5%be%8c%e3%81%ab%e5%8b%95%e3%81%8b%e3%81%aa%e3%81%8f%e3%81%aa%e3%81%a3%e3%81%9f/", "text": "作業日数\n約3週間\n\n採用サイトの新規制作（応募フォーム連携）\n\n課題採用情報が分散し応募につながりにくい 解決応募フォーム連携の採用サイトを新規制作 \n\n420,000円（税込）\n制作プラン \n詳しくはこちら", "alt_title": ""}, {"href": "https://wprescue.jp/case/page/2/", "text": "2", "alt_title": ""}, {"href": "https://wprescue.jp/case/page/3/", "text": "3", "alt_title": ""}, {"href": "https://wprescue.jp/case/page/2/", "text": "»", "alt_title": ""}, {"href": "https://wprescue.jp/contact/", "text": "WordPressの悩みを無料相談", "alt_title": ""}, {"href": "https://wprescue.jp/service/", "text": "サービス概要", "alt_title": ""}, {"href": "https://wprescue.jp/service/diagnosis/", "text": "診断項目", "alt_title": ""}, {"href": "https://wprescue.jp/service/flow/", "text": "作業の流れ", "alt_title": ""}, {"href": "https://wprescue.jp/service/sandbox/", "text": "検証環境について", "alt_title": ""}, {"href": "https://wprescue.jp/price/", "text": "料金", "alt_title": ""}, {"href": "https://wprescue.jp/wordpress-fix/", "text": "不具合・トラブル復旧", "alt_title": ""}, {"href": "https://wprescue.jp/wordpress-security/", "text": "脆弱性診断・セキュリティ", "alt_title": ""}, {"href": "https://wprescue.jp/wordpress-seo/", "text": "SEO・検索順位改善", "alt_title": ""}, {"href": "https://wprescue.jp/wordpress-speed/", "text": "表示速度改善", "alt_title": ""}, {"href": "https://wprescue.jp/wordpress-migration/", "text": "サーバ移転・引っ越し", "alt_title": ""}, {"href": "https://wprescue.jp/wordpress-php-upgrade/", "text": "PHPバージョンアップ対応", "alt_title": ""}, {"href": "https://wprescue.jp/wordpress-custom-plugin/", "text": "カスタムプラグイン開発", "alt_title": ""}, {"href": "https://wprescue.jp/contact-improvement/", "text": "問い合わせ導線改善", "alt_title": ""}, {"href": "https://wprescue.jp/maintenance-switch/", "text": "制作会社の乗り換え", "alt_title": ""}, {"href": "https://wprescue.jp/case/", "text": "改善事例", "alt_title": ""}, {"href": "https://wprescue.jp/blog/", "text": "お役立ち情報", "alt_title": ""}, {"href": "https://wprescue.jp/faq/", "text": "よくある質問", "alt_title": ""}, {"href": "https://web.runland.co.jp/", "text": "運営会社", "alt_title": ""}, {"href": "https://wprescue.jp/contact/", "text": "お問い合わせ", "alt_title": ""},