title": ""}, {"href": "https://creativecommons.org/licenses/by/2.0/", "text": "CC BY 2.0 License", "alt_title": ""}, {"href": "https://www.flickr.com/photos/johny/", "text": "John Kraus", "alt_title": ""}, {"href": "https://creativecommons.org/licenses/by/2.0/", "text": "CC BY 2.0 License", "alt_title": ""}, {"href": "https://www.flickr.com/photos/geishaboy500/", "text": "THOR", "alt_title": ""}, {"href": "https://creativecommons.org/licenses/by/2.0/", "text": "CC BY 2.0 License", "alt_title": ""}, {"href": "https://www.flickr.com/photos/stf-o/", "text": "stephane", "alt_title": ""}, {"href": "https://creativecommons.org/licenses/by/2.0/", "text": "CC BY 2.0 License", "alt_title": ""}, {"href": "http://www.pexels.com/", "text": "Pexels", "alt_title": ""}, {"href": "http://www.pexels.com/photo-license/", "text": "CC0 License", "alt_title": ""}, {"href": "https://stocksnap.io/", "text": "Stocksnap", "alt_title": ""}, {"href": "https://stocksnap.io/license", "text": "CC0 License", "alt_title": ""}, {"href": "http://picjumbo.com/", "text": "Picjumbo", "alt_title": ""}, {"href": "http://picjumbo.com/about-author/", "text": "Picjumbo License", "alt_title": ""}, {"href": "http://mazwai.com/", "text": "Mazwai", "alt_title": ""}, {"href": "https://creativecommons.org/licenses/by/3.0/", "text": "CC BY 3.0 License", "alt_title": ""}, {"href": "http://designmodo.com/", "text": "Designmodoh", "alt_title": ""}, {"href": "http://designmodo.com/linecons-free/", "text": "License", "alt_title": ""}, {"href": "#about", "text": "About Us", "alt_title": ""}, {"href": "#work", "text": "Our Work", "alt_title": ""}, {"href": "https://www.youtube.com/watch?v=K7fi2_nwD2k", "text": "制作の裏側", "alt_title": ""}, {"href": "https://studio-flare.work/", "text": "XRスタジオ", "alt_title": ""}, {"href": "images/2021_LEXTMAP.pdf", "text": "サブスクリプション型プロジェクションマッピングをNEWリリース「LEXTMAP」", "alt_title": ""}, {"href": "https://www.creators-station.jp/interview/legends/230241", "text": "“ある心配”でダンサーから映像クリエイターの道へ！プロジェクションマッピングは「ひとつのスパイス」", "alt_title": "Creators MediaCreator"}, {"href": "profile.php", "text": "自己紹介", "alt_title": ""}, {"href": "#work", "text": "実績内容はコチラから", "alt_title": ""}, {"href": "#", "text": "All", "alt_title": ""}, {"href": "#", "text": "プレゼン用ＣＧ", "alt_title": ""}, {"href": "#", "text": "プロジェクションマッピング", "alt_title": ""}, {"href": "#", "text": "ライトアップ演出", "alt_title": ""}, {"href": "#", "text": "イベント・展示会", "alt_title": ""}, {"href": "#", "text": "撮影・映像制作", "alt_title": ""}, {"href": "#", "text": "モデル・ＭＣキャスティング", "alt_title": ""}, {"href": "#", "text": "インフォグラフィックス", "alt_title": ""}, {"href": "#", "text": "CM", "alt_title": ""}, {"href": "#", "text": "センシング・実験", "alt_title": ""}, {"href": "#", "text": "スマホアプリ開発", "alt_title": ""}, {"href": "#!portfolio-item-61.html", "text": "完全オリジナル版バレエ『くるみ割り人形』\n2026年2月 バレエ公演にてプロジェクションマッピングを行いました。", "alt_title": ""}, {"href": "#!portfolio-item-60.html", "text": "大阪成蹊大学 駅前キャンパス\n2026年2月3.4.5日 大阪成蹊大学 駅前キャンパスにてプロジェクションマッピングを行いました。", "alt_title": ""}, {"href": "#!portfolio-item-59.html", "text": "EXPO2025 大阪・関西万博『 シャインハット』\n2025年10月8.9.10日 シャインハットにてプロジェクションマッピングを行いました。", "alt_title": ""}, {"href": "#!portfolio-item-58.html", "text": "完全オリジナル版バレエ『美女と野獣』\n2025年8月 バレエ公演にてプロジェクションマッピングを行いました。", "alt_title": ""}, {"href": "#!portfolio-item-57.html", "text": "2025 KASUGA SUMMER FESTIVAL\n航空自衛隊 春日基地で行われた「2025 KASUGA SUMMER FESTIVAL」にて、弊社がプロジェクションマッピングを担当いたしました。", "alt_title": ""}, {"href": "#!portfolio-item-56.html", "text": "ストリートダンススタジオ『ALICE IN WONDER REMIND』\nキッズ発表会にてプロジェクションマッピング・照明演出を行いました。また、オリジナルLEDコスチューム制作、音にリンクしたオリジナルの作品になりました。", "alt_title": ""}, {"href": "#!portfolio-item-55.html", "text": "完全オリジナル版バレエ『白雪姫』\n完全オリジナル版バレエ『白雪姫』 バレエ公演にてプロジェクションマッピングを行いました。", "alt_title": ""}, {"href": "#!portfolio-item-54.html", "text": "新都市ライフホールディングス様\nUI制作・LEDコントロール株式会社モノリス様と共同で行いました。", "alt_title": ""}, {"href": "#!portfolio-item-52.html", "text": "志摩観光ホテル全方位プロジェクションマッピング\n企業様の社員旅行サプライズ演出でプロジェクションマッピング施工いたしました。", "alt_title": ""}, {"href": "#!portfolio-item-51.html", "text": "完全オリジナル版バレエ『美女と野獣』\n2024年8月 バレエ公演にてプロジェクションマッピングを行いました。", "alt_title": "The Bullet Show"}, {"href": "#!portfolio-item-53.html", "text": "完全オリジナル版バレエ『アラジン』\n2024年1月・2月 バレエ公演にてプロジェクションマッピングを行いました。", "alt_title": "The Bullet Show"}, {"href": "#!portfolio-item-50.html", "text": "両国国技館\n2023年11月23日（木）株式会社太陽ホールディングス様 70周年記念イベントにてプロジェクションマッピングを行いました。", "alt_title": "両国国技館"}, {"href": "#!portfolio-item-49.html", "text": "プロジェクションマッピング in 大和高田\n2023年12月18日誘さざんかホール正面壁面と馬鈴池の水面を使ったプロジェクションマッピングをおこないました。", "alt_title": "プロジェクションマッピング in 大和高田"}, {"href": "#!portfolio-item-48.html", "text": "大阪　某ラグジュアリーホテル\n2023年11月18日（土）メインエントランス（幅10m高さ10ｍ）壁面にセンサを用いたインタラクティブなプロジェクションマッピングを行いました", "alt_title": "2023 laxury hotel"}, {"href": "#!portfolio-item-46.html", "text": "大阪　某ラグジュアリーホテル\n2023年9月28日（木）壁面にインスタストーリーソーシャルハブ+プロジェクションマッピングを行いました。", "alt_title": "2023 laxury hotel"}, {"href": "#!portfolio-item-45.html", "text": "大阪　某ラグジュアリーホテル\n2023年9月1日（金）メインエントランス（幅8m高さ6ｍ）壁面にセンサを用いたインタラクティブなプロジェクションマッピングを行いました。", "alt_title": "2023 laxury hotel"}, {"href": "#!portfolio-item-44.html", "text": "2023　WAH YAH FESL\n2023年7月9日　りんくう野外文化音楽堂にて夏フェスがおこなわれました", "alt_title": "2023 RDF RECITAL"}, {"href": "#!portfolio-item-43.html", "text": "2023 RDF RECITAL\nなら100年会館にてリマインドダンスファクトリーのリサイタルがおこなわれました。ホログラムスクリーンを使用しプロジェクションマッピング・照明演出を行いました。", "alt_title": "2023 RDF RECITAL"}, {"href": "#!portfolio-item-42.html", "text": "オペラ　ヘンゼルとグレーテル\nヴィアーレ大阪にてオペラ舞台にプロジェクションマッピング+照明演出をおこないました。", "alt_title": "三恵グループ70周年記念"}, {"href": "#!portfolio-item-41.html", "text": "三恵グループ70周年記念式典\n三恵グループ70周年記念式典にて、プロジェクションマッピング＆照明演出の施工・オペレーションを行いました。", "alt_title": "三恵グループ70周年記念"}, {"href": "#!portfolio-item-40.html", "text": "DAIGAS　Group第３０回記念　品質大会プロジェクションマッピング＋照明演出施工\nDAIGAS　Group　第３０回記念　品質大会にて、プロジェクションマッピング＆照明演出の施工・オペレーションを行いました。", "alt_title": "DAIGAS　Group第３０回記念　品質大会"}, {"href": "#!portfolio-item-39.html", "text": "京都府立医科大学150周年式典プロジェクションマッピング＆照明演出\n京都府立医科大学150周年式典にて、プロジェクションマッピング＆照明演出の施工・オペレーションを行いました。", "alt_title": "京都府立医科大学150周年"}, {"href": "#!portfolio-item-38.html", "text": "ハ日市新川広域河川改修工事プロジェクションマッピング＆照明演出\n八日市新川河川工事現場にて、プロジェクションマッピング＆照明演出の施工・オペレーションを行いました。", "alt_title": "ハ日市新川広域河川改修工事プロジェクションマッピング＆ライトアップ"}, {"href": "#!portfolio-item-37.html", "text": "京都市交響楽団プロジェクションマッピング＆照明演出\n京都市交響楽団の演奏会場（京都コンサート大ホール）にて生演奏とプロジェクションマッピング＆照明演出の施工・オペレーションを行いました。", "alt_title": "京都市交響楽団プロジェクションマッピング＆ライトアップ"}, {"href": "#!portfolio-item-32.html", "text": "ライトアップ演出更にステージ照明演出と音響演出もご一緒に\nライトアップ演出と同時に、ステージを盛り上げる照明・音響演出も同時に行うことができます。", "alt_title": "②広範囲なライトアップ照明演出にも対応できます"}, {"href": "#!portfolio-item-31.html", "text": "広範囲なライトアップイベント演出\nエリアの広いライトアップでも対応いたします。また、動画配信に向けた撮影も同時に行うことができます。", "alt_title": "①広範囲なライトアップ照明演出にも対応できます"}, {"href": "#!portfolio-item-30.html", "text": "スマホアプリ開発\nスマホアプリの開発も行っております！イベントに向けたアプリなどなど、ぜひ、一度ご相談ください。", "alt_title": "スマホアプリ開発"}, {"href": "#!portfolio-item-29.html", "text": "サプライズプロジェクションマッピング\n特別な日のプロジェクションマッピングを、映像制作から機材搬入からオペレーションまで円滑に行います。", "alt_title": "卒業式典・プロジェクションマッピング・映像制作"}, {"href": "#!portfolio-item-26.html", "text": "プロジェクションマッピングシステム開発\n提灯へのプロジェクションマッピングと照明を施工・演出しました。\n                                                    商店街の方でも簡単に操作できるよう、インターフェイスとシステム開発も行いました。", "alt_title": "千日前道具屋筋商店街の巨大提灯プロジェクションマッピング＆照明演出、システム開発"}, {"href": "#!portfolio-item-25.html", "text": "プロモーション映像制作\n５Ｇの到来によって社会がどのように変化すると思いますか？\n                                                    今まで以上に情報配信の必要性が高まり高品質な映像が求められるようになります。", "alt_title": "5G時代の到来！映像制作プロモーション　撮影・映像制作"}, {"href": "#!portfolio-item-23.html", "text": "CM\n30秒CMでは、短い時間の中で伝えたいメッセージをイメージ付けする為にBGMやナレーションなど印象的にすることによってターゲットに向けて商品を記憶してもらいやすくします。", "alt_title": "Youtubeチャンネル内の30秒CM制作「ゲンナイ製薬様 時期別葉酸サプリ プレミンシリーズ」"}, {"href": "#!portfolio-item-22.html", "text": "映像制作\nライブイベントなど、大型イベント会場で利用されることが多いステージ後方のバックスクリーン。映像制作や映像演出のご提案を行っております。", "alt_title": "「Tokyo 7th Sisters 5th Anniversary Live in Makuhari Messe」ライブステージのバックスクリーンに映し出される映像制作を担当いたしました。"}, {"href": "#!portfolio-item-21.html", "text": "映像制作 +ダンス発表会オペ＆撮影\n会場サイネージの映像制作と照明プラン作成、オペレーションにてリハからフィナーレまで携わることができます。サプライズのご相談もお受けいたします。", "alt_title": "クラブピカデリー梅田大阪にて、映像制作・照明プランニング・オペレーション・撮影"}, {"href": "#!portfolio-item-20.html", "text": "センシング +プロジェクションマッピング\nセンシング技術との組み合わせで、対象物の解析結果をプロモーション映像に反映させることができ、プロジェクションマッピングの演出方法に新しい表現を加えることができます。", "alt_title": "Mercedes-Benzディーラーにて、センシングライトアップシステム"}, {"href": "#!portfolio-item-19.html", "text": "センシング照明演出システム\nセンサー技術を利用したライトアップシステムを開発しました。対象物と人との距離でライトアップの光色が変わるので参加型演出として一味違う空間演出ができます。", "alt_title": "道の駅なないろななえセンシングライトアップシステム"}, {"href": "#!portfolio-item-18.html", "text": "ライトアップ演出\nライトアップ対象物によって照明演出の選定などご相談から承っております。演出方法のご提案や運搬・設置・撤去、映像撮影や動画制作のご相談も一緒に行うことができます。", "alt_title": "上野東照宮ライトアップ演出"}, {"href": "#!portfolio-item-17.html", "text": "センシング ＋ﾀﾞﾝｽﾊﾟﾌｫｰﾏﾝｽ\nセンシング技術をダンスパフォーマンスに組み込むことで、プロジェクションマッピングの表現を活かした新しい演出方法を提案できるようになりました。", "alt_title": "プロジェクションマッピング"}, {"href": "#!portfolio-item-2.html", "text": "WEB動画\n言葉では伝わらない多くの情報を伝えることができる見る人の印象に残りやすい信頼されやすくなる可能性があるなどといったメリットがあります。", "alt_title": "WEB動画"}, {"href": "#!portfolio-item-9.html", "text": "ライトアップ演出\nライトアップ対象物によって照明演出の選定などご相談から承っております。演出方法のご提案や運搬・設置・撤去、映像撮影や動画制作のご相談も一緒に行うことができます。", "alt_title": "ライトアップ演出"}, {"href": "#!portfolio-item-3.html", "text": "イベント・展示会\nイベント・展示会の、ブースデザインや什器設計・搬入設置・撤去など一貫して行っております。また、イベント開催の映像記録や編集も行っております。", "alt_title": "イベント・展示会"}, {"href": "#!portfolio-item-4.html", "text": "CM\nテレビCMはメディアの中でも信頼度が高く、影響力が強い、というのが最大のメリットです。認知度を高めたい時などは幅広い層に見てもらえるので効果的でしょう。", "alt_title": "CM"}, {"href": "#!portfolio-item-5.html", "text": "プロジェクションマッピング\n【大阪芸大短期学部　卒業公演】演出考案・映像制作・撮影から機材搬入・設置、現場オペレーションまで一貫しておこないました。ダンサーが映像とコラボするシーンはとても素敵でした！", "alt_title": "プロジェクションマッピング"}, {"href": "#!portfolio-item-6.html", "text": "ダンス発表会\n【リマインドダンスファクトリー】弊社代表が脚本・演出・演者・振り付け・映像制作・オペレーションまで一貫して行いました。子供たちの可能性を感じた最高の作品でした！", "alt_title": "ダンス発表会"}, {"href": "#!portfolio-item-7.html", "text": "イベント\n【お茶の京都博】特別公演プロジェクションマッピング+ダンスにて京都府から感謝状をいただきました。", "alt_title": "イベント"}, {"href": "#unity", "text": "", "alt_title": ""}, {"href