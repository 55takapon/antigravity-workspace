: 174, "base_url": "https://www.hatsukaze.co.jp/", "links": [{"href": "https://www.hatsukaze.co.jp/", "text": "", "alt_title": "はつかぜ株式会社"}, {"href": "https://www.hatsukaze.co.jp/", "text": "ホーム", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/apps/", "text": "アプリ開発", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/dx/", "text": "DX/システム開発", "alt_title": ""}, {"href": "#", "text": "サービス", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/support/", "text": "IT支援サービス", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/lp/watchsystem/", "text": "おしごとみえるっち", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/lp/securitygate/", "text": "セキュリティゲート", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/support/", "text": "IT支援サービス", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/cases/", "text": "事例紹介", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/corporate/", "text": "会社紹介", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/inquire/", "text": "お問い合わせ", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/recruit/", "text": "採用案内", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/docs/", "text": "資料ダウンロード", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/faq/", "text": "よくあるご質問", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/en/", "text": "ENGLISH", "alt_title": ""}, {"href": "./corporate/", "text": "続きを見る", "alt_title": ""}, {"href": "./corporate/", "text": "続きを見る", "alt_title": ""}, {"href": "./apps/", "text": "続きを見る", "alt_title": ""}, {"href": "./apps/shop/", "text": "販売促進アプリ\n店舗により多く足を運んでいただくために新商品や新サービスのご案内、クーポン配信を行うことができます。", "alt_title": "販売促進アプリ"}, {"href": "./apps/ec/", "text": "ショッピングアプリ\nPUSH通知を利用してキャンペーンや新商品の情報をすぐに届けることができるネットショップを実現します。", "alt_title": "ショッピングアプリ"}, {"href": "./apps/business/", "text": "業務改善アプリ\n営業先や店舗、倉庫など離れた場所でも在庫確認や発注、出荷指示などの業務が簡単にできます。", "alt_title": "業務改善アプリ"}, {"href": "./apps/information/", "text": "情報配信アプリ\n不動産や店舗、地域情報といった価値ある新しい情報を届けたい人にわかりやすく届けることができます。", "alt_title": "情報配信アプリ"}, {"href": "./apps/device/", "text": "機器連動アプリ\nカメラやセンサーなどの機器とスマートフォンなどを接続してリアルタイムに状況を把握することができます。", "alt_title": "機器連動アプリ"}, {"href": "./apps/entertainment/", "text": "エンタメアプリ\nゲームや新しい体験の楽しさを共有して、遠く離れた他の誰かを笑顔にすることができます。", "alt_title": "エンタメアプリ"}, {"href": "./apps/", "text": "続きを見る", "alt_title": ""}, {"href": "./dx/", "text": "続きを見る", "alt_title": ""}, {"href": "./dx/", "text": "続きを見る", "alt_title": ""}, {"href": "./support/", "text": "続きを見る", "alt_title": ""}, {"href": "./support/", "text": "続きを見る", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/case/auto-pattern-optimization/", "text": "デジタル活用による生産性向上と資源最適化を実現する業務改善事例\nExcel連携で型紙配置を自動最適化し効率化を支援 システム導入の目的 段取り作業をスムーズにして、ムダな手間を減らす 材料をできるだけ有効に使い、ロスを抑える 作業を早く・正確に進め、ミスややり直しを減らす 導入された […]", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/case/lidar/", "text": "【距離計測や物体認識の新手法】LiDARセンサーの様々な活用紹介\nLiDARは、レーザー光を用いて物体までの距離を高精度に測定する技術で、自動運転技術や建築・土木工学など、多岐にわたる分野で活用されています。", "alt_title": "LiDARセンサー"}, {"href": "https://www.hatsukaze.co.jp/case/security_gate/", "text": "【顔認証セキュリティゲートで実現】入場者管理と来客受付の効率化\n顔認証機に連動したセキュリティゲートの設置により、非接触で入場することを実現しました。また、会議室予約と来客予約が連動したシステムを導入し、入場記録管理と受付対応に関わる業務を効率化しました。", "alt_title": "security_gate"}, {"href": "https://www.hatsukaze.co.jp/case/nursing-home/", "text": "【介護現場をシステム化で支援】送迎から施設利用まで情報を一元管理\n介護施設の送迎から施設利用までを管理するシステムを開発。送迎計画の作成時間を1日から1時間に短縮し、施設予約作業の簡略化と施設利用状況の共有を実現しました。", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/case/ar-hammering-test-solution/", "text": "【建築物の打音検査をアプリで実現】職人の感覚や高額機器に頼らない最新技術の開発\n打音結果のTFFT画像と位置情報などを組み合わせてAR（拡張現実）によって欠陥箇所を可視化するアプリの開発を行いました。", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/case/kirindo/", "text": "事例）キリン堂公式アプリ\n利用者130万人を超えるドラッグストア キリン堂の会員アプリを開発しました。基幹システムと連動した顧客分析や、顧客ニーズに応じた情報提供を実現しています。", "alt_title": ""}, {"href": "./corporate/", "text": "続きを見る", "alt_title": ""}, {"href": "https://www.hatsukaze.co.jp/news/%e5%a4%8f%e5%ad%a3%e4%bc%91%e6%a5%ad%e3%81%ae%e3%81%8a%e7%9f%a5%e3%82%89%e3%81%9b