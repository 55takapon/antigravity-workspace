title": ""}, {"href": "movie-shooting.html", "text": "ムービー撮影", "alt_title": ""}, {"href": "st_enter.html", "text": "スタジオメニュー", "alt_title": ""}, {"href": "modelinfo", "text": "", "alt_title": "商品撮影モデルリストのリンクバナー"}, {"href": "modelinfo", "text": "詳しくはこちら ＞", "alt_title": ""}, {"href": "option-background.html", "text": "", "alt_title": "撮影背景&小物のリンクバナー"}, {"href": "option-background.html", "text": "詳しくはこちら ＞", "alt_title": ""}, {"href": "online.html", "text": "", "alt_title": "オンライン立ち会い撮影のリンクバナー"}, {"href": "online.html", "text": "詳しくはこちら ＞", "alt_title": ""}, {"href": "sample-photo.html", "text": "", "alt_title": "撮影サンプルのリンクバナー"}, {"href": "sample-photo.html", "text": "詳しくはこちら ＞", "alt_title": ""}, {"href": "https://select-type.com/s/epa", "text": "", "alt_title": "EPA エイトバイテン・フォト・アカデミーのリンクバナー"}, {"href": "epa.html", "text": "詳しくはこちら ＞", "alt_title": ""}, {"href": "firstperson-flow.html", "text": "", "alt_title": "初めての方へ・撮影の流れ初めての方へ・撮影の流れ"}, {"href": "various-shooting-services.html", "text": "", "alt_title": "各種撮影各種撮影"}, {"href": "sample-photo.html", "text": "", "alt_title": "撮影サンプル撮影サンプル"}, {"href": "https://www.studio8x10.com/package-model.html", "text": "EC撮影-モデル撮影パック\n\nスタジオ エイト・バイ・テンは各ジャンル、イメージのモデルが豊富。充実のモデルリストからお選びいただけます。", "alt_title": "EC撮影パック-モデル撮影パック"}, {"href": "https://www.studio8x10.com/package-object.html", "text": "EC撮影-商品撮影パック\n\nECサイトでは手にとって商品を見ることができません。ディティール画像やイメージ撮影お任せください。", "alt_title": "EC撮影パック-商品撮影パック"}, {"href": "https://www.studio8x10.com/package-mix.html", "text": "EC撮影-ミックス撮影パック\n\nモデル撮影&商品撮影、両方撮り。撮影する商品が少ない場合にオススメのパッケージ。", "alt_title": "EC撮影パック-ミックス撮影パック"}, {"href": "https://www.studio8x10.com/package-location.html", "text": "EC撮影-ロケーション/ハウススタジオ撮影パック\n\n被写体、写真自体の魅力が更にアップします。ブランディングやECサイトでの商品イメージ、企業イメージ作りに。", "alt_title": "EC撮影パック-ロケーション/ハウススタジオ撮影パック"}, {"href": "https://www.studio8x10.com/studio-item-shooting.html", "text": "商品撮影【物撮り】\n\n商品が持つ魅力・特徴・性質・深み・重み・輝き・しずる感などをあますことなく。クオリティの差を実感してください。", "alt_title": "商品撮影【物撮り】"}, {"href": "https://www.studio8x10.com/studio-fashionmodel-shooting.html", "text": "モデル撮影\n\nポージングや表情によって被写体のもつ魅力を。モデルのマッチングから全てお任せください。", "alt_title": "モデル撮影"}, {"href": "https://www.studio8x10.com/trip-location-shooting.html", "text": "出張撮影-ロケーション撮影\n\n同じ被写体でもロケーションを変えただけで変化します。面倒なロケ申請もお任せください。", "alt_title": "出張撮影-ロケーション撮影"}, {"href": "https://www.studio8x10.com/trip-housestudio-shooting.html", "text": "出張撮影-ハウススタジオ撮影\n\n様々なコンセプトのハウススタジオで撮影。数あるスタジオの手配から出張撮影まで。", "alt_title": "出張撮影-ハウススタジオ撮影"}, {"href": "https://www.studio8x10.com/trip-event-shooting.html", "text": "出張撮影-イベント・ブライダル・ショー\n\n社員総会や納会など大きなイベントから、前撮り・挙式・披露宴などのプライベートなイベントまで、その瞬間瞬間を逃さず撮影。", "alt_title": "出張撮影-イベント・ブライダル・ショー"}, {"href": "https://www.studio8x10.com/trip-profile-shooting.html", "text": "出張撮影-会社案内・学校案内\n\n会社案内・学校案内では、WEBページや印刷物を作成する上で、写真が最も重要になります。", "alt_title": "出張撮影-会社案内・学校案内"}, {"href": "https://www.studio8x10.com/trip-shop-shooting.html", "text": "出張撮影-ホテル・ショップ・レストラン\n\n今やネットでホテルやお店を選ぶのは当たり前の時代。美しい写真でしっかり魅力をアピールしましょう。", "alt_title": "出張撮影-ホテル・ショップ・レストラン"}, {"href": "https://www.studio8x10.com/trip-building-shooting.html", "text": "出張撮影-建築・住宅\n\n建設中の建物撮影や、モデルハウスの撮影など、内観・外観撮影を含め全て撮影いたします。", "alt_title": "出張撮影-建築・住宅"}, {"href": "https://www.studio8x10.com/trip-food-shooting.html", "text": "食品撮影\n\n角度やライティング等によって、その「食品本来の魅力」をさらに惹き出します。", "alt_title": "食品撮影"}, {"href": "https://www.studio8x10.com/publicity-shooting.html", "text": "宣材撮影・人物撮影\n\nオーディション用写真撮影、チラシ作成用写真撮影、パンフレット作成用写真撮影など。", "alt_title": "宣材撮影・人物撮影"}, {"href": "https://www.studio8x10.com/option-web.html#cont_01", "text": "白背景加工\n\n商品画像の背景を白色に加工することにより、商品のイメージを向上させます。ディティール画像も必要に応じて加工いたします。", "alt_title": "白背景加工"}, {"href": "https://www.studio8x10.com/option-web.html#cont_02", "text": "肌調整加工\n\n人物モデルの肌質の調整を行います。アクセサリー等で高級感が必要な商品ページでは特に有効な加工です。", "alt_title": "肌調整加工"}, {"href": "https://www.studio8x10.com/option-web.html#cont_03", "text": "色変更加工\n\n色を加工により変更します。\n撮影用のモックが無い場合、カラバリ紹介等で同じアングルの画像を使用したい場合に。", "alt_title": "色変更加工"}, {"href": "movie-shooting.html", "text": "詳しくはこちらClick here to read more.", "alt_title": ""}, {"href": "e-movie.html", "text": "詳しくはこちらClick here to read more.", "alt_title": ""}, {"href": "option-background.html", "text": "", "alt_title": "撮影背景&小物撮影背景&小物"}, {"href": "option-hairmake.html", "text": "", "alt_title": "ヘア＆メイク・スタイリストヘア＆メイク・スタイリスト"}, {"href": "option-web.html", "text": "", "alt_title": "切り抜き&レタッチ切り抜き&レタッチ"}, {"href": "st_explanetion.html", "text": "", "alt_title": "スタジオリニューアル"}, {"href": "https://www.studio8x10.com/wp_2017/wp-content/themes/s810/images/st_explanation/studio_layout_south.jpg", "text": "", "alt_title": "撮影スタジオレイアウト"}, {"href": "https://www.studio8x10.com/wp_2017/wp-content/themes/s810/images/st_explanation/studio_layout_east.jpg", "text": "", "alt_title": "撮影スタジオレイアウト"}, {"href": "https://www.studio8x10.com/wp_2017/wp-content/themes/s810/images/st_explanation/studio_layout_north.jpg", "text": "", "alt_title": "撮影スタジオレイアウト"}, {"href": "https://www.studio8x10.com/wp_2017/wp-content/themes/s810/images/st_explanation/studio_layout_west.jpg", "text": "", "alt_title": "撮影スタジオレイアウト"}, {"href": "st_explanetion.html", "text": "", "alt_title": "スタジオメニュー 一覧"}, {"href": "package-model.html", "text": "詳しくはこちらClick here to read more.", "alt_title": ""}, {"href": "package-object.html", "text": "詳しくはこちらClick here to read more.", "alt_title": ""}, {"href": "package-location.html", "text": "詳しくはこちらClick here to read more.", "alt_title": ""}, {"href": "option-web.html#cont_02", "text": "詳しくはこちらClick here to read more.", "alt_title": ""}, {"href": "/studio-item-shooting.html", "text": "商品撮影【物撮り】", "alt_title": ""}, {"href": "/studio-fashionmodel-shooting.html", "text": "モデル撮影", "alt_title": ""}, {"href": "/trip-location-shooting.html", "text": "ロケーション撮影", "alt_title": ""}, {"href": "/trip-housestudio-shooting.html", "text": "ハウススタジオ撮影", "alt_title": ""}, {"href": "/trip-event-shooting.html", "text": "イベント・ブライダル・ショー", "alt_title": ""}, {"href": "/trip-profile-shooting.html", "text": "会