[{"idx": 329, "_row": 2872, "company_name": "株式会社Another Field", "base_url": "https://slinc.jp", "links": [{"href": "https://slinc.jp/", "text": "", "alt_title": "SAIKAKU"}, {"href": "https://slinc.jp/", "text": "ホーム", "alt_title": ""}, {"href": "https://slinc.jp/servicemenu/", "text": "サービス", "alt_title": ""}, {"href": "https://slinc.jp/web_ad/", "text": "採用マーケティングシステム", "alt_title": ""}, {"href": "https://slinc.jp/creatorsters_terrace/", "text": "動画制作サービス", "alt_title": ""}, {"href": "https://slinc.jp/fantasista/", "text": "採用WEBマーケティング研修", "alt_title": ""}, {"href": "https://slinc.jp/method/", "text": "SAIKAKUのメソッド", "alt_title": ""}, {"href": "https://slinc.jp/works/", "text": "実績", "alt_title": ""}, {"href": "https://slinc.jp/hajimetenokata/", "text": "会社紹介", "alt_title": ""}, {"href": "https://slinc.jp/message/", "text": "代表メッセージ", "alt_title": ""}, {"href": "https://slinc.jp/philosophy/", "text": "企業理念", "alt_title": ""}, {"href": "https://slinc.jp/companyprofile/", "text": "会社概要", "alt_title": ""}, {"href": "https://slinc.jp/consultation/", "text": "お問合せ", "alt_title": ""}, {"href": "https://slinc.jp/method/", "text": "SAIKAKUのメソッドを見る", "alt_title": ""}, {"href": "#js-cb", "text": "", "alt_title": ""}, {"href": "", "text": "SAIKAKUの特長１\n200件以上の実績でビジネス課題を解決\n\n私たちSAIKAKUでは、効果実証済みのノウハウを駆使し、成果にこだわった採用戦略を提供します。", "alt_title": ""}, {"href": "", "text": "SAIKAKUの特長２\n幅広い業種に対応\n\n店舗ビジネス全般・無形の商品サービス・地方自治体・観光協会・医療施設などなど、様々な業種に対応できます。", "alt_title": ""}, {"href": "", "text": "SAIKAKUの特長３\n経験豊富なコンサルタントがチームで進行\n\nCUEでは、１案件ごとに専属の担当者が付き企業に寄り添ったサービスを提供します。\r\n直接お会いする他に、ネット会議のZOOMを利用したり、専用のチャットを開設しプロジェクトを進行していきます。", "alt_title": ""}, {"href": "https://slinc.jp/cue3elected/", "text": "SAIKAKUの特徴を見る", "alt_title": ""}, {"href": "https://slinc.jp/servicemenu/", "text": "採用マーケティングシステム\n地方中小企業に合ったマーケティング戦略で、採用単価を下げながら欲しい人材を獲得することができます。\n\n人材に課題がある企業・官公庁・医療機関などに、採用マーケティングを組み合わせ、欲しい人材をお金をかけずに獲得する仕組みを提供します。", "alt_title": ""}, {"href": "https://slinc.jp/servicemenu/", "text": "動画活用コンサルティング\n動画マーケティングでビジネスを成長させます。\n\n現状分析・リサーチ・ターゲット設定・KPI設計などを行い、動画を最大限に活用したアクションプランを提供します。", "alt_title": ""}, {"href": "https://slinc.jp/servicemenu/", "text": "動画制作サービス\n安価でお手軽に動画を発注できるサービスです。\n\nよりわかりやすく・より伝わるような動画で、効果的な動画を制作します。", "alt_title": ""}, {"href": "https://slinc.jp/servicemenu/", "text": "サービスを詳しく見る", "alt_title": ""}, {"href": "https://slinc.jp/news/%e7%a4%be%e5%90%8d%e5%a4%89%e6%9b%b4%e3%81%ae%e3%81%8a%e7%9f%a5%e3%82%89%e3%81%9b/", "text": "2025.03.10\n社名変更のお知らせ", "alt_title": ""}, {"href": "https://slinc.jp/news/%e6%98%8e%e3%81%91%e3%81%be%e3%81%97%e3%81%a6%e3%81%8a%e3%82%81%e3%81%a7%e3%81%a8%e3%81%86%e3%81%94%e3%81%96%e3%81%84%e3%81%be%e3%81%99%e3%80%82/", "text": "2025.01.01\n明けましておめでとうございます。", "alt_title": ""}]}, {"idx": 330, "_row": 2873, "company_name": "有限会社エヌティ・クリエイト", "base_url": "https://ntcreate.co.jp", "links": [{"href": "https://ntcreate.co.jp/", "text": "", "alt_title": ""}, {"href": "https://www.facebook.com/profile.php?id=100057635040596", "text": "", "alt_title": ""}, {"href": "https://www.instagram.com/info.ntc/", "text": "", "alt_title": ""}, {"href": "https://twitter.com/ntcreate", "text": "", "alt_title": ""}, {"href": "https://www.youtube.com/channel/UCGGPBRDIB07VzfPjuYwRZXQ", "text": "", "alt_title": ""}, {"href": "https://liff.line.me/1645278921-kWRPP32q?openerPlatform=native&openerKey=urlSchema%3Aexternal&accountId=fhu8660j#mst_challenge=8GQCrvHo0MZcxMfOShy1SSb7kFBdpHfuL03xUUqMBsw", "text": "", "alt_title": ""}, {"href": "http://", "text": "", "alt_title": ""}, {"href": "https://ntcreate.co.jp/", "text": "", "alt_title": ""}, {"href": "https://www.facebook.com/profile.php?id=100057635040596", "text": "", "alt_title": ""}, {"href": "https://www.instagram.com/info.ntc/", "text": "", "alt_title": ""}, {"href": "https://twitter.com/ntcreate", "text": "", "alt_title": ""}, {"href": "https://www.youtube.com/channel/UCGGPBRDIB07VzfPjuYwRZXQ", "text": "", "alt_title": ""}, {"href": "https://lin.ee/AXZMs8D", "text": "", "alt_title": 