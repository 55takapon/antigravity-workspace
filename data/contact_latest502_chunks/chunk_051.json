[{"idx": 319, "_row": 2862, "company_name": "株式会社ラフ", "base_url": "https://roughinc.com", "links": [{"href": "https://roughinc.com", "text": "", "alt_title": ""}, {"href": "https://roughinc.com/about", "text": "ABOUT", "alt_title": ""}, {"href": "https://roughinc.com/company", "text": "COMPANY", "alt_title": ""}, {"href": "https://roughinc.com/contact", "text": "CONTACT", "alt_title": ""}, {"href": "https://roughinc.com/news", "text": "NEWS", "alt_title": ""}, {"href": "https://www.youtube.com/watch?v=i9nyAWiTenc", "text": "大一倉庫15秒CM", "alt_title": ""}, {"href": "https://www.youtube.com/watch?v=T95A-EpXKlE", "text": "株式会社ラフ　動画制作実績", "alt_title": "株式会社ラフで作成してきたPVのフラッシュ動画です。"}, {"href": "https://www.youtube.com/watch?v=2pLSnT0-WLE", "text": "MONZEN", "alt_title": ""}, {"href": "https://www.youtube.com/watch?v=lCsTnFEd3Yc", "text": "廣峯神社", "alt_title": ""}, {"href": "https://www.youtube.com/watch?v=mwzM-NVUXlw", "text": "TAANNERR 職人", "alt_title": ""}, {"href": "https://www.youtube.com/watch?v=Nh6InGTg8lk", "text": "カスタムオーダー", "alt_title": ""}, {"href": "https://www.youtube.com/channel/UCyVua4kwZEjfJZT0LR28rSw", "text": "ROUCHINC. CHANNEL", "alt_title": ""}, {"href": "https://www.instagram.com/p/DamDXPAkwb9/", "text": "兵庫県加西市の「加西サイサイまつり」のポスタービジュアルを制作いたしました。\n今年はより沢山の方にご", "alt_title": "兵庫県加西市の「加西サイサイまつり」のポスタービジュアルを制作いたしました。\n今年はより沢山の方にご参加いただけるように、イラストを使用したキャッチーなデザインにしたいとのご要望をいただきましたので、イラストレーターにオリジナルイラストを書き下ろしてもらいデザインいたしました。\n\n- - - - - - - - - -"}, {"href": "https://www.instagram.com/p/DaUHr5CE3Ht/", "text": "セントクレアヒルズ様のブライダルキャンペーンチラシを制作。\n水族館とのコラボレーションで叶える、特別", "alt_title": "セントクレアヒルズ様のブライダルキャンペーンチラシを制作。\n水族館とのコラボレーションで叶える、特別な一日をテーマにしたブライダル企画。\n世界観のあるビジュアルと、キャンペーン内容の分かりやすさを両立できるよう構成・デザインしました。\n\n- - - - - - - - - - - - - - - - - - - - -"}, {"href": "https://www.instagram.com/p/DZMTr1CkZUq/", "text": "特殊電極株式会社様の高校生向けリクルートパンフレットを制作しました。\n「どんな仕事をしている会社なの", "alt_title": "特殊電極株式会社様の高校生向けリクルートパンフレットを制作しました。\n「どんな仕事をしている会社なのか」、「働く人たちはどんな想いで仕事をしているのか」\n仕事内容をわかりやすく整理しながら、思わず開きたくなるデザインに仕上げています。\nこれから進路を考える学生の皆さんに、会社の魅力や働くイメージがまっすぐ届くパンフレッ"}, {"href": "https://www.instagram.com/p/DZCelcZE6Jr/", "text": "兵庫県姫路市に本社のある\n「千代田レイヤー」様のバスラッピング、駅貼広告・看板を制作いたしました。", "alt_title": "兵庫県姫路市に本社のある\n「千代田レイヤー」様のバスラッピング、駅貼広告・看板を制作いたしました。\n2023年に会社名を変更された際に、ロゴマークを作成させていただきました。\nその時のデザインコンセプトと、人々の「当たり前の日常」を支える「安心と安全を塗り重ねる仕事」への姿勢を、デザインに落とし込みました。\n- - -"}, {"href": "https://www.instagram.com/reel/DYon1NOzJso/", "text": "2025年度松山空港の利用促進キャンペーンの一環で、テレビ放送用のCMを制作いたしました。オリジナル", "alt_title": "2025年度松山空港の利用促進キャンペーンの一環で、テレビ放送用のCMを制作いたしました。オリジナルキャラクターのアニメーションと実写を組み合わせて構成しています。\n\n- - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n松山空港国際線　ソウル•釜山•台北 "}, {"href": "https://www.instagram.com/p/DYWKciqkZwp/", "text": "兵庫県行政書士会 姫路支部様の広報誌「行政書士ひめじ」のパンフレットを制作しております。\n2011年", "alt_title": "兵庫県行政書士会 姫路支部様の広報誌「行政書士ひめじ」のパンフレットを制作しております。\n2011年から弊社で制作させていただいているので、今年で15年目になります。\n- - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n兵庫県姫路市にオフィスを構える【株式"}, {"href": "https://www.instagram.com/p/DYDyGpgE-HS/", "text": "110年以上の歴史を持つタンナーがつくるレザーアイテムブランド\n「TAANNERR（タァンネリル）」", "alt_title": "110年以上の歴史を持つタンナーがつくるレザーアイテムブランド\n「TAANNERR（タァンネリル）」のパンフレットを制作いたしました。\n- - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n兵庫県姫路市にオフィスを構える【株式会社ラフ】では、\n各種デザイン・"}, {"href": "https://www.instagram.com/p/DXyMph3kRxW/", "text": "四季折々の自然に包まれた、開放感あふれるウエディング空間\n結婚式場SARA様の「5周年スペシャルキャ", "alt_title": "四季折々の自然に包まれた、開放感あふれるウエディング空間\n結婚式場SARA様の「5周年スペシャルキャンペーンチラシ」を\n制作させていただきました。\n\n5周年の感謝と特別感が伝わるよう、\n上品で華やかな雰囲気を大切にデザインいたしました。\n\n- - - - - - - - - - - - - - - - - - - - "}, {"href": "https://www.instagram.com/reel/DXV29L9k0oL/", "text": "岡山県津山市にある「北欧」が建築テーマのガーデン付貸切邸宅\n「結婚式場 SARA津山」様の公式サイト", "alt_title": "岡山県津山市にある「北欧」が建築テーマのガーデン付貸切邸宅\n「結婚式場 SARA津山」様の公式サイトのフルリニューアルを制作いたしました。\n\n- - - - - - - - - - - - - - - - - - - - - - - - - - - - -\nSARA津山　@sara_wedding2020\n- - - "}, {"href": "https://www.instagram.com/reel/DW71HLyE3Q0/", "text": "JR姫路駅から徒歩1分・兵庫県姫路市のNEW SPOT「MONZEN」様の撮影・編集をいたしました。", "alt_title": "JR姫路駅から徒歩1分・兵庫県姫路市のNEW SPOT「MONZEN」様の撮影・編集をいたしました。\n旅の途中にふらりと訪れていただける「食」「もの」「案内」「文化」の新たな玄関口を、魅力的にご紹介するPVに仕上げました。\n\nMONZENでは兵庫の魅力を味わい、兵庫のつくり手たちの逸品を手にとっていただくことができます"}, {"href": "https://www.instagram.com/p/DWprzQckwb9/", "text": "令和8年4月5日(日)まで開催の\n姫路城夜桜会のポスタービジュアルを制作いたしました。\n桜と姫路城と", "alt_title": "令和8年4月5日(日)まで開催の\n姫路城夜桜会のポスタービジュアルを制作いたしました。\n桜と姫路城と光の饗宴を是非お楽しみください。\n\n#姫路城 \n#姫路城夜桜会 \n#春彩舞桜 \n#graphicdesigns \n#himeji"}, {"href": "https://www.instagram.com/p/DWXustBk1uI/", "text": "常時300点以上の衣装を揃えるサロンドラヴィール様（@salon_de_ravir ）のリーフレット", "alt_title": "常時300点以上の衣装を揃えるサロンドラヴィール様（@salon_de_ravir ）のリーフレットを制作させていただきました。\n花嫁さまの「こんなドレスを着てみたい」という憧れに出会う、小さなきっかけになれば嬉しいです。\n\n#pamphlet \n#ウェディングドレス \n#結婚式ドレス \n#designoffice \n"}, {"href": "https://www.instagram.com/p/DWDNLyJEwNM/", "text": "軍師・黒田官兵衛とも縁のある廣峯神社様のイメージPVを制作いたしました。\n廣峯神社様は姫路市の北側に", "alt_title": "軍師・黒田官兵衛とも縁のある廣峯神社様のイメージPVを制作いたしました。\n廣峯神社様は姫路市の北側に位置する広峰山山頂にある社で、姫路市街と播磨灘を一望できます。\n陰陽道を用いた九星の守護神にお祈りする「陰陽九星詣り」や、眺望の良さをいかしたドローン撮影行いました。\n\n#映像制作\n#動画撮影\n#黒田官兵衛 \n#廣峯神社"}]}, {"idx": 320, "_row": 2863, "company_name": "株式会社きらり✧", "base_url": "https://kilari.co.jp", "links": [{"href": "https://kilari.co.jp/", "text": "Top", "alt_title": ""}, {"href": "https://kilari.co.jp/about/", "text": "About", "alt_title": ""}, {"href": "https://kilari.co.jp/service/", "text": "Service", "alt_title": ""}, {"href": "https://kilari.co.jp/works/", "text": "Our works", "alt_title": ""}, {"href": "https://kilari.co.jp/contact", "text": "Contact", "alt_title": ""}, {"href": "https://www.instagram.com/kirari__inc/", "text": "", "alt_title": "instagraminstagram"}, {"href": "#facebook", "text": "", "alt_title": ""}, {"href": "https://www.instagram.com/kirari__inc/", "text": "", "alt_title": ""}, {"href": "https://kilari.co.jp/service/", "text": "Service", "alt_title": ""}, {"href": "https://kilari.co.jp/about/", "text": "About", "alt_title": ""}, {"href": "https://kilari.co.jp/works/", "text": "And more", "alt_title": ""}, {"href": "#", "text": "Topics\nお知らせ・ブ