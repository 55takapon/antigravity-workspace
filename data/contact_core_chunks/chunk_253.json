[{"idx": 1957, "_row": 1963, "company_name": "株式会社CAI", "base_url": "http://www.cai-ideas.biz/", "links": [{"href": "https://cai-ideas.biz/", "text": "", "alt_title": "株式会社CAI"}, {"href": "https://cai-ideas.biz/", "text": "HOME", "alt_title": ""}, {"href": "https://cai-ideas.biz/service/", "text": "SERVICE", "alt_title": ""}, {"href": "https://cai-ideas.biz/company/", "text": "COMPANY", "alt_title": ""}, {"href": "https://cai-ideas.biz/recruit/", "text": "RECRUIT", "alt_title": ""}, {"href": "https://cai-ideas.biz/contact/", "text": "CONTACT", "alt_title": ""}, {"href": "https://cai-ideas.biz/company/", "text": "View more", "alt_title": ""}, {"href": "https://cai-ideas.biz/service/", "text": "View more", "alt_title": ""}, {"href": "https://cai-ideas.biz/service/#promotion", "text": "View more", "alt_title": ""}, {"href": "https://cai-ideas.biz/interview/#member-62", "text": "取締役専務\n私は学生時代、音楽大学で作曲を勉強していました。その頃からシンセサイ\r\nザーなどでの音作りやVJなど映像音響機材に触ることが好きでした。\r\nその興味もあり卒業後はイベント関係の映像機器レンタル会社にて働いていました。\r\n縁あってCAIに入社し、現在は各部門全体を管理しながら医療系の学会・セミナー、企業イベン", "alt_title": ""}, {"href": "https://cai-ideas.biz/interview/#member-49", "text": "執行役員・テクニカル部門部長・TCセンター長\n学生時代、音響の専門学校を卒業。\r\n卒業後、今は懐かしい着メロ・着うたを制作している会社に就職しました。\r\n(ガラケー時代)\r\n各端末に合わせたマスタリング作業、レコーティングスタジオもあったためそこでの業務を経験。\r\nその後、友人からの誘いで会館のテクニカルスタッフに転職", "alt_title": ""}, {"href": "https://cai-ideas.biz/interview/#member-156", "text": "執行役員・コンベンション部門部長\n2011年に、テレビの制作会社を離れ、CAIに入社しました。\r\nコンベンション部門として、営業をメインにチームの管理と教育を行っております。", "alt_title": ""}, {"href": "https://cai-ideas.biz/interview/#member-169", "text": "イベント部門部長\n業界30年越えとなる門真（もんま）です。\r\n皆様の、お困り事を真摯に受け止め、日々奮闘しております。\r\nMICEに該当する案件では、多岐に渡り関わらせていただきました。\r\n什器機材、映像、音響、照明機器から美術造作までお客様、参加者のニーズにお答えできるよう、チーム一丸となって取り組んでおります。", "alt_title": ""}, {"href": "https://cai-ideas.biz/interview/#member-134", "text": "総務部門部長・管理部門兼務\n私は現在、現場担当業務、社内スケジュール管理、外注手配関係、会計業務などを主に担当しております。\r\n学生時代は、14年間バレーボールに励み、たくさんの事を培いました。\r\n一度は別の会社へ勤めましたが、CAIへ転職し、培ってきた事を生かしながら日々奮闘しております。", "alt_title": ""}, {"href": "https://cai-ideas.biz/interview/#member-99", "text": "テクニカル部門 Aグループリーダー\n尚美ミュージックカレッジ専門学校Rec専攻\r\n\r\n担当業務\r\nAグループリーダーとしてチームの管理・育成\r\n医学会の映像オペレーター\r\n現場使用機材のメンテナンス\r\n発表データの受付など‥", "alt_title": ""}, {"href": "https://cai-ideas.biz/interview/#member-86", "text": "テクニカル部門 Bグループリーダー\n東京都出身。\r\n尚美ミュージックカレッジ専門学校 レコーディング専攻卒業\r\n仕事は社内では機材のメンテナンスや現場の機材準備などをしています。\r\n現場では会場のオペレーションや発表データの取扱などをしています。", "alt_title": ""}, {"href": "https://cai-ideas.biz/interview/#member-948", "text": "テクニカル部門Cグループリーダー\n日本工学院八王子専門学校にてレコーディングを学び、音響技術に関する基礎を身につけました。\r\n現在はテクニカルチームのCグループリーダーとして、メンバーの管理や育成に力を入れています。\r\n社内では機材メンテナンスや準備をはじめ、会場でのオペレーション、発表データの管理・資料作成からイベン", "alt_title": ""}, {"href": "https://cai-ideas.biz/recruit/#member-interview", "text": "All Interviews", "alt_title": ""}, {"href": "https://cai-ideas.biz/recruit/", "text": "View more", "alt_title": ""}, {"href": "https://cai-ideas.biz/contact/", "text": "メールフォームはこちら", "alt_title": "mail icon"}, {"href": "tel:+81358355670", "text": "+81-3-5835-5670", "alt_title": "tel icon"}, {"href": "https://cai-ideas.biz/", "text": "", "alt_title": "CAI logo"}, {"href": "tel:0358355670", "text": "03-5835-5670", "alt_title": ""}, {"href": "tel:0358355675", "text": "03-5835-5675", "alt_title": ""}, {"href": "https://cai-ideas.biz/", "text": "HOME", "alt_title": ""}]}, {"idx": 1958, "_row": 1964, "company_name": "株式会社シグマコミュニケーションズ", "base_url": "https://www.sigma-com.co.jp/", "links": [{"href": "https://www.mystargroup.jp/", "text": "", "alt_title": "ãã¤ã¹ã¿ã¼ã¨ã³ã¸ãã¢ãªã³ã°ã°ã«ã¼ã"}, {"href": "/", "text": "", "alt_title": "æ ªå¼ä¼ç¤¾ã·ã°ãã³ãã¥ãã±ã¼ã·ã§ã³ãº"}, {"href": "/aboutus/", "text": "ä¼æ¥­æå ±", "alt_title": ""}, {"href": "/contact/", "text": "ãåãåãã", "alt_title": ""}, {"href": "/recruit/", "text": "ä¸­éæ¡ç¨", "alt_title": ""}, {"href": "/recruit/fresh/", "text": "æ°åæ¡ç¨", "alt_title": ""}, {"href": "/pfi/", "text": "æå®ç®¡çã»PFI", "alt_title": ""}, {"href": "/hall/",